<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_advance" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.advance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//label[@for='transfer_account_id']/parent::div"
                position="after"
            >
                <div class="row mt8">
                    <label
                        for="account_customer_advance_id"
                        class="col-lg-5 o_light_label"
                        string="Cuenta de anticipos de cliente"
                    />
                    <field name="account_customer_advance_id" />
                </div>
                <div class="row mt8">
                    <label
                        for="account_supplier_advance_id"
                        class="col-lg-5 o_light_label"
                        string="Cuenta de anticipos de proveedor"
                    />
                    <field name="account_supplier_advance_id" />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
