<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_payment_register_form_advance" model="ir.ui.view">
        <field name="name">account.payment.register.form.advance</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form" />
        <field name="arch" type="xml">
            <field name="line_ids" position="after">
                <field name="l10n_ve_apply_advance" invisible="1" />
                <field name="show_advance_difference_handling" invisible="1" />
                <field name="l10n_ve_has_advance_source_payment" invisible="1" />
            </field>
            <field name="journal_id" position="before">
                <field name="l10n_ve_advance_line_id" invisible="1" force_save="1" />
                <field
                    name="l10n_ve_advance_line_id"
                    readonly="1"
                    groups="base.group_no_one"
                    invisible="not l10n_ve_apply_advance"
                />
                <field
                    name="l10n_ve_advance_amount_available"
                    readonly="1"
                    invisible="not l10n_ve_apply_advance"
                />
                <field name="l10n_ve_invoice_amount_residual" invisible="1" />
            </field>
            <field name="journal_id" position="attributes">
                <attribute
                    name="invisible"
                >l10n_ve_has_advance_source_payment</attribute>
            </field>
            <field name="payment_method_line_id" position="attributes">
                <attribute
                    name="invisible"
                >l10n_ve_has_advance_source_payment</attribute>
            </field>
            <field name="partner_bank_id" position="attributes">
                <attribute
                    name="invisible"
                >l10n_ve_apply_advance or not show_partner_bank_account or not can_edit_wizard or (can_group_payments and not group_payment)</attribute>
            </field>
            <field name="group_payment" position="attributes">
                <attribute
                    name="invisible"
                >l10n_ve_apply_advance or not can_group_payments</attribute>
            </field>
            <xpath expr="//label[@for='amount']" position="attributes">
                <attribute name="invisible">l10n_ve_apply_advance</attribute>
            </xpath>
            <xpath expr="//label[@for='amount']" position="after">
                <label
                    for="amount"
                    string="Importe a aplicar"
                    invisible="not l10n_ve_apply_advance"
                />
            </xpath>
            <xpath
                expr="//div[@name='amount_div']/field[@name='amount']"
                position="attributes"
            >
                <attribute
                    name="readonly"
                >not l10n_ve_apply_advance and (not can_edit_wizard or (can_group_payments and not group_payment))</attribute>
            </xpath>
            <xpath
                expr="//div[@name='amount_div']/field[@name='currency_id']"
                position="attributes"
            >
                <attribute
                    name="invisible"
                >not l10n_ve_apply_advance and (not can_edit_wizard or (can_group_payments and not group_payment))</attribute>
            </xpath>
            <field name="installments_switch_html" position="attributes">
                <attribute
                    name="invisible"
                >l10n_ve_apply_advance or not installments_switch_html</attribute>
            </field>
            <field name="communication" position="attributes">
                <attribute
                    name="invisible"
                >not l10n_ve_apply_advance and (not can_edit_wizard or (can_group_payments and not group_payment))</attribute>
            </field>
            <field name="payment_difference_handling" position="attributes">
                <attribute name="invisible">is_register_payment_on_draft</attribute>
                <attribute name="widget">l10n_ve_payment_difference_handling</attribute>
            </field>
            <xpath
                expr="//field[@name='writeoff_account_id']/ancestor::div[hasclass('o_inner_group')]"
                position="attributes"
            >
                <attribute
                    name="invisible"
                >hide_writeoff_section or payment_difference_handling != 'reconcile'</attribute>
            </xpath>
            <xpath
                expr="//footer/button[@name='action_create_payments'][1]"
                position="attributes"
            >
                <attribute
                    name="invisible"
                >l10n_ve_apply_advance or total_payments_amount == 1</attribute>
            </xpath>
            <xpath
                expr="//footer/button[@name='action_create_payments'][2]"
                position="attributes"
            >
                <attribute
                    name="invisible"
                >l10n_ve_apply_advance or total_payments_amount != 1</attribute>
            </xpath>
            <xpath expr="//footer/button[@special='cancel']" position="before">
                <button
                    string="Aplicar anticipo"
                    name="action_create_payments"
                    type="object"
                    class="oe_highlight"
                    data-hotkey="q"
                    invisible="not l10n_ve_apply_advance"
                />
            </xpath>
        </field>
    </record>
</odoo>
