<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.l10n.ve.base.vat</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_vat.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="vies_service_setting" position="after">
                <setting
                    id="l10n_ve_validate_partner_vat_format_setting"
                    company_dependent="1"
                    invisible="country_code != 'VE'"
                    help="Valida que el RIF o la cédula de identidad de los contactos cumplan el formato exigido por el SENIAT."
                >
                    <field name="l10n_ve_validate_partner_vat_format" />
                </setting>
            </setting>
        </field>
    </record>
</odoo>
