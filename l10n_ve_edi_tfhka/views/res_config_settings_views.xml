<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_l10n_ve_edi_tfhka" model="ir.ui.view">
        <field name="name">res.config.settings.l10n.ve.edi.tfhka</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//block[@name='fiscal_localization_setting_container']"
                position="after"
            >
                <block
                    name="l10n_ve_edi_tfhka_block"
                    title="Facturacion Digital The Factory HKA"
                >
                    <setting
                        string="Ambiente activo"
                        help="Los documentos se envían con la URL y las credenciales de este ambiente."
                        class="col-lg-12"
                    >
                        <field name="tfhka_api_environment" widget="radio" />
                        <div class="mt16">
                            <button
                                name="action_test_tfhka_connection"
                                type="object"
                                string="Probar conexión"
                                class="btn-primary"
                            />
                        </div>
                    </setting>
                    <setting string="Producción" class="col-12 col-lg-6">
                        <div class="content-group">
                            <div class="row mt16">
                                <label
                                    for="tfhka_production_url"
                                    string="URL"
                                    class="col-lg-4 o_light_label"
                                />
                                <field
                                    name="tfhka_production_url"
                                    placeholder="https://..."
                                    required="tfhka_api_environment == 'production'"
                                    class="col-lg-8"
                                />
                            </div>
                            <div class="row">
                                <label
                                    for="tfhka_username_production"
                                    string="Usuario"
                                    class="col-lg-4 o_light_label"
                                />
                                <field
                                    name="tfhka_username_production"
                                    class="col-lg-8"
                                />
                            </div>
                            <div class="row">
                                <label
                                    for="tfhka_password_production"
                                    string="Clave"
                                    class="col-lg-4 o_light_label"
                                />
                                <field
                                    name="tfhka_password_production"
                                    password="True"
                                    class="col-lg-8"
                                />
                            </div>
                        </div>
                    </setting>
                    <setting string="Pruebas" class="col-12 col-lg-6">
                        <div class="content-group">
                            <div class="row mt16">
                                <label
                                    for="tfhka_test_url"
                                    string="URL"
                                    class="col-lg-4 o_light_label"
                                />
                                <field
                                    name="tfhka_test_url"
                                    placeholder="https://demoemisionv2.thefactoryhka.com.ve"
                                    class="col-lg-8"
                                />
                            </div>
                            <div class="row">
                                <label
                                    for="tfhka_username_test"
                                    string="Usuario"
                                    class="col-lg-4 o_light_label"
                                />
                                <field name="tfhka_username_test" class="col-lg-8" />
                            </div>
                            <div class="row">
                                <label
                                    for="tfhka_password_test"
                                    string="Clave"
                                    class="col-lg-4 o_light_label"
                                />
                                <field
                                    name="tfhka_password_test"
                                    password="True"
                                    class="col-lg-8"
                                />
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_l10n_ve_edi_tfhka_retention" model="ir.ui.view">
        <field name="name">res.config.settings.l10n.ve.edi.tfhka.retention</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="l10n_ve_edi.res_config_settings_l10n_ve_edi_retention"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='l10n_ve_edi_iva_supplier_retention_provider']/.."
                position="after"
            >
                <div
                    class="row mt16"
                    invisible="l10n_ve_edi_iva_supplier_retention_provider != 'tfhka'"
                >
                    <label
                        string="Serie (TFHKA)"
                        for="tfhka_iva_supplier_retention_edi_serie"
                        class="col-lg-6 o_light_label"
                    />
                    <field
                        name="tfhka_iva_supplier_retention_edi_serie"
                        class="col-lg-6"
                    />
                </div>
                <div
                    class="row mt16"
                    invisible="l10n_ve_edi_iva_supplier_retention_provider != 'tfhka'"
                >
                    <label
                        string="Sucursal / establecimiento (TFHKA)"
                        for="tfhka_iva_supplier_retention_edi_sucursal"
                        class="col-lg-6 o_light_label"
                    />
                    <field
                        name="tfhka_iva_supplier_retention_edi_sucursal"
                        class="col-lg-6"
                    />
                </div>
            </xpath>
            <xpath
                expr="//field[@name='l10n_ve_edi_islr_supplier_retention_provider']/.."
                position="after"
            >
                <div
                    class="row mt16"
                    invisible="l10n_ve_edi_islr_supplier_retention_provider != 'tfhka'"
                >
                    <label
                        string="Serie (TFHKA)"
                        for="tfhka_islr_supplier_retention_edi_serie"
                        class="col-lg-6 o_light_label"
                    />
                    <field
                        name="tfhka_islr_supplier_retention_edi_serie"
                        class="col-lg-6"
                    />
                </div>
                <div
                    class="row mt16"
                    invisible="l10n_ve_edi_islr_supplier_retention_provider != 'tfhka'"
                >
                    <label
                        string="Sucursal / establecimiento (TFHKA)"
                        for="tfhka_islr_supplier_retention_edi_sucursal"
                        class="col-lg-6 o_light_label"
                    />
                    <field
                        name="tfhka_islr_supplier_retention_edi_sucursal"
                        class="col-lg-6"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
