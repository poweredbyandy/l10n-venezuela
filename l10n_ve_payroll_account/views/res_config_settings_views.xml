<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_l10n_ve_payroll_account" model="ir.ui.view">
        <field name="name">res.config.settings.l10n.ve.payroll.account</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_ve_payroll.res_config_settings_view_form_l10n_ve_payroll" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='l10n_ve_payroll_partners']" position="after">
                <block
                    title="Venezuela - Employee loans"
                    name="l10n_ve_payroll_loan_account"
                >
                    <setting
                        id="l10n_ve_payroll_loan_receivable"
                        company_dependent="1"
                        string="Loan receivable account"
                        help="SENIAT account used as debit when disbursing employee loans (default 1106002 Prestamos a empleados). Not chosen per loan."
                    >
                        <div class="content-group">
                            <div class="row mt16">
                                <label
                                    for="loan_receivable_account_id"
                                    class="col-lg-3 o_light_label"
                                />
                                <field
                                    name="loan_receivable_account_id"
                                    class="col-lg-4"
                                    options="{'no_create': True}"
                                />
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
