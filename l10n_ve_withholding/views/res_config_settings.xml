<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_l10n_ve_withholding" model="ir.ui.view">
        <field name="name">res.config.settings.l10n.ve.payment.extension</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block position="inside" id="default_accounts">
                <setting name="condition_withholding_settings" string="Condición de Retención" help="Condición utilizada para registrar las retenciones">
                    <label string="Condición de Retención" for="condition_withholding_id" class="col-lg-6 o_light_label" />
                    <field name="condition_withholding_id" />
                </setting>
                <setting name="type_person_settings" string="Tipo de Persona" help="Tipo de persona de la compañía">
                    <label string="Tipo de Persona" for="type_person_id" class="col-lg-6 o_light_label" />
                    <field name="type_person_id" />
                </setting>
                <setting name="code_visible_settings" string="Mostrar Código en Reportes" help="Mostrar el código en los reportes de ISLR">
                    <field name="code_visible" />
                </setting>
                <setting name="retention_iva_journals_settings" string="Retenciones de IVA" help="Configuraciones necesarias para registrar las retenciones de IVA">
                    <div class="content-group">
                        <div class="row mt16">
                            <label string="Supplier Journal" for="iva_supplier_retention_journal_id" class="col-lg-6 o_light_label" />
                            <field name="iva_supplier_retention_journal_id" class="col-lg-6" />
                        </div>
                        <div class="row mt16">
                            <label string="Customer Journal" for="iva_customer_retention_journal_id" class="col-lg-6 o_light_label" />
                            <field name="iva_customer_retention_journal_id" class="col-lg-6" />
                        </div>
                    </div>
                </setting>
                <setting name="retention_islr_journals_settings" string="Retenciones de ISLR" help="Configuraciones necesarias para registrar las retenciones de ISLR">
                    <div class="content-group">
                        <div class="row mt16">
                            <label string="Supplier Journal" for="islr_supplier_retention_journal_id" class="col-lg-6 o_light_label" />
                            <field name="islr_supplier_retention_journal_id" class="col-lg-6" />
                        </div>
                        <div class="row mt16">
                            <label string="Customer Journal" for="islr_customer_retention_journal_id" class="col-lg-6 o_light_label" />
                            <field name="islr_customer_retention_journal_id" class="col-lg-6" />
                        </div>
                        <div class="d-flex mt4 align-items-center">
                            <button name="action_open_payment_concepts" string="Conceptos de Pago" type="object" class="btn-link ml-2" icon="oi-arrow-right" />
                        </div>
                        <div class="d-flex align-items-center">
                            <button name="action_open_tax_units" string="Unidades Tributarias" type="object" class="btn-link" icon="oi-arrow-right" />
                        </div>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>