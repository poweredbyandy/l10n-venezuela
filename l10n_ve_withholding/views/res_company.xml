<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form" model="ir.ui.view">
        <field name="name">l10n.ve.payment.extensionres.company.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="tax_authorities_data" string="Tax Authorities Data">
                    <group>
                        <group>
                            <field name="tax_authorities_name" />
                            <field name="economic_activity_number" />
                            <field name="type_person_id" string="Type Person" />
                        </group>
                        <group>
                            <field name="tax_authorities_logo" widget="image" class="oe_avatar" />
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
    <!-- Inherit SENIAT kanban to add withholding fields -->
    <record id="res_company_kanban_view_withholding" model="ir.ui.view">
        <field name="name">res.company.kanban.withholding</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_ve_seniat.res_company_kanban_view" />
        <field name="arch" type="xml">
            <field position="after" name="taxpayer_type">
                <field name="type_person_id" />
            </field>
        </field>
    </record>
    <!-- Inherit SENIAT company form to add withholding fields -->
    <record id="res_company_form_view_withholding" model="ir.ui.view">
        <field name="name">res.company.form.withholding</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_ve_seniat.res_company_form_view_seniat" />
        <field name="arch" type="xml">
            <field position="after" name="taxpayer_type">
                <field name="type_person_id" string="Type Person" />
            </field>
        </field>
    </record>
</odoo>