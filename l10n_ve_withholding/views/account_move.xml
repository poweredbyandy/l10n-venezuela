<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_move_form_l10n_ve_withholding" model="ir.ui.view">
        <field name="name">account.move.form.l10n.ve.payment.extension</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_iva_retention_lines"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-percent"
                    invisible="not retention_iva_line_ids"
                >
                    <field
                        name="retention_iva_count"
                        widget="statinfo"
                        string="IVA Retentions"
                    />
                </button>
                <button
                    name="action_view_islr_retention_lines"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-percent"
                    invisible="not retention_islr_line_ids"
                >
                    <field
                        name="retention_islr_count"
                        widget="statinfo"
                        string="ISLR Retentions"
                    />
                </button>
                <button
                    name="action_view_municipal_retention_lines"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-building"
                    invisible="not retention_municipal_line_ids"
                >
                    <field
                        name="retention_municipal_count"
                        widget="statinfo"
                        string="Municipal Retentions"
                    />
                </button>
            </xpath>

            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <field name="iva_retention_id" invisible="1" />
                <field name="islr_retention_id" invisible="1" />
                <field name="municipal_retention_id" invisible="1" />
                <field name="not_edit_municipal_retention_lines" invisible="1" />
                <field
                    name="generate_iva_retention"
                    invisible="state != 'draft' or move_type not in ('in_invoice', 'in_receipt', 'in_refund')"
                />
                <label
                    for="iva_voucher_number"
                    string="Comprobante retención IVA"
                    invisible="move_type not in ('in_invoice', 'in_receipt', 'in_refund') or not iva_voucher_number"
                />
                <div
                    class="d-inline-flex flex-nowrap align-items-center gap-2"
                    invisible="move_type not in ('in_invoice', 'in_receipt', 'in_refund') or not iva_voucher_number"
                >
                    <field
                        name="iva_voucher_number"
                        nolabel="1"
                        readonly="1"
                        class="oe_inline w-auto"
                    />
                    <button
                        name="action_open_iva_retention"
                        type="object"
                        class="btn-link px-1 py-0 flex-shrink-0 align-baseline"
                        icon="fa-external-link"
                        title="Abrir retención de IVA"
                        invisible="not iva_retention_id"
                    />
                    <button
                        name="action_print_iva_retention"
                        type="object"
                        class="btn-link px-1 py-0 flex-shrink-0 align-baseline"
                        icon="fa-print"
                        title="Print IVA retention"
                        invisible="not iva_retention_id"
                    />
                </div>
                <label
                    for="islr_voucher_number"
                    string="Comprobante retención ISLR"
                    invisible="move_type not in ('in_invoice', 'in_receipt', 'in_refund') or not islr_voucher_number"
                />
                <div
                    class="d-inline-flex flex-nowrap align-items-center gap-2"
                    invisible="move_type not in ('in_invoice', 'in_receipt', 'in_refund') or not islr_voucher_number"
                >
                    <field
                        name="islr_voucher_number"
                        nolabel="1"
                        readonly="1"
                        class="oe_inline w-auto"
                    />
                    <button
                        name="action_open_islr_retention"
                        type="object"
                        class="btn-link px-1 py-0 flex-shrink-0 align-baseline"
                        icon="fa-external-link"
                        title="Abrir retención de ISLR"
                        invisible="not islr_retention_id"
                    />
                    <button
                        name="action_print_islr_retention"
                        type="object"
                        class="btn-link px-1 py-0 flex-shrink-0 align-baseline"
                        icon="fa-print"
                        title="Print ISLR retention"
                        invisible="not islr_retention_id"
                    />
                </div>
                <label
                    for="municipal_voucher_number"
                    string="Comprobante retención municipal"
                    invisible="move_type not in ('in_invoice', 'in_receipt', 'in_refund') or not municipal_voucher_number"
                />
                <div
                    class="d-inline-flex flex-nowrap align-items-center gap-2"
                    invisible="move_type not in ('in_invoice', 'in_receipt', 'in_refund') or not municipal_voucher_number"
                >
                    <field
                        name="municipal_voucher_number"
                        nolabel="1"
                        readonly="1"
                        class="oe_inline w-auto"
                    />
                    <button
                        name="action_open_municipal_retention"
                        type="object"
                        class="btn-link px-1 py-0 flex-shrink-0 align-baseline"
                        icon="fa-external-link"
                        title="Abrir retención municipal"
                        invisible="not municipal_retention_id"
                    />
                    <button
                        name="action_print_municipal_retention"
                        type="object"
                        class="btn-link px-1 py-0 flex-shrink-0 align-baseline"
                        icon="fa-print"
                        title="Print municipal retention"
                        invisible="not municipal_retention_id"
                    />
                </div>
                <field name="company_currency_id" invisible="1" />
            </xpath>

            <xpath
                expr="//field[@name='tax_lock_date_message']/parent::div"
                position="after"
            >
                <field name="l10n_ve_missing_iva_withholding_type" invisible="1" />
                <div
                    class="alert alert-warning d-flex align-items-center mb-0"
                    role="alert"
                    invisible="not l10n_ve_missing_iva_withholding_type"
                >
                    El contacto seleccionado no tiene configurado el porcentaje de
                    retención de IVA. Configure el campo «Tipo de retención» en la
                    ficha del contacto antes de confirmar la operación.
                </div>
            </xpath>

            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']"
                position="after"
            >
                <field name="ciu_id" optional="hide" />
            </xpath>
        </field>
    </record>

    <record id="view_move_form_iva_retention_lines" model="ir.ui.view">
        <field name="name">account.move.form.iva.retention.lines</field>
        <field name="model">account.move</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <form string="IVA Retentions">
                <field name="company_currency_id" invisible="1" />
                <field name="retention_iva_line_ids" nolabel="1" readonly="1">
                    <list editable="bottom">
                        <field name="invoice_type" column_invisible="True" />
                        <field name="company_currency_id" column_invisible="True" />
                        <field name="name" />
                        <field name="move_id" />
                        <field name="aliquot" />
                        <field name="related_percentage_tax_base" optional="hide" />
                        <field
                            name="invoice_total"
                            widget="monetary"
                            options="{'currency_field': 'company_currency_id'}"
                        />
                        <field
                            name="invoice_amount"
                            widget="monetary"
                            options="{'currency_field': 'company_currency_id'}"
                        />
                        <field
                            name="iva_amount"
                            widget="monetary"
                            options="{'currency_field': 'company_currency_id'}"
                        />
                        <field
                            name="retention_amount"
                            widget="monetary"
                            options="{'currency_field': 'company_currency_id'}"
                        />
                        <field name="state" />
                    </list>
                </field>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="view_move_form_islr_retention_lines" model="ir.ui.view">
        <field name="name">account.move.form.islr.retention.lines</field>
        <field name="model">account.move</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <form string="ISLR Retentions">
                <field name="company_currency_id" invisible="1" />
                <field name="move_type" invisible="1" />
                <field name="state" invisible="1" />
                <field
                    name="retention_islr_line_ids"
                    nolabel="1"
                    readonly="move_type not in ('in_invoice', 'in_refund') or state != 'draft'"
                >
                    <list editable="bottom">
                        <field name="invoice_type" column_invisible="True" />
                        <field name="company_currency_id" column_invisible="True" />
                        <field name="name" />
                        <field name="payment_concept_id" />
                        <field
                            name="invoice_total"
                            readonly="1"
                            force_save="1"
                            widget="monetary"
                            options="{'currency_field': 'company_currency_id'}"
                        />
                        <field
                            name="invoice_amount"
                            force_save="1"
                            string="Invoice Amount"
                            widget="monetary"
                            options="{'currency_field': 'company_currency_id'}"
                        />
                        <field
                            name="related_pay_from"
                            force_save="1"
                            readonly="1"
                        />
                        <field
                            name="related_percentage_tax_base"
                            force_save="1"
                            readonly="1"
                        />
                        <field
                            name="related_percentage_fees"
                            force_save="1"
                            readonly="1"
                        />
                        <field
                            name="related_amount_subtract_fees"
                            force_save="1"
                            readonly="1"
                        />
                        <field
                            name="retention_amount"
                            readonly="1"
                            force_save="1"
                            widget="monetary"
                            options="{'currency_field': 'company_currency_id'}"
                        />
                        <field name="state" />
                    </list>
                </field>
                <footer>
                    <button string="Save" special="save" class="btn-primary" />
                    <button string="Close" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="view_move_form_municipal_retention_lines" model="ir.ui.view">
        <field name="name">account.move.form.municipal.retention.lines</field>
        <field name="model">account.move</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <form string="Municipal Retentions">
                <field name="company_currency_id" invisible="1" />
                <field name="move_type" invisible="1" />
                <field name="state" invisible="1" />
                <field name="not_edit_municipal_retention_lines" invisible="1" />
                <field
                    name="retention_municipal_line_ids"
                    nolabel="1"
                    readonly="move_type not in ('in_invoice', 'in_refund') or state != 'draft' or not_edit_municipal_retention_lines"
                >
                    <list editable="bottom">
                        <field name="company_currency_id" column_invisible="True" />
                        <field
                            name="name"
                            force_save="1"
                            readonly="1"
                            column_invisible="True"
                        />
                        <field name="economic_activity_id" force_save="1" />
                        <field name="aliquot" readonly="1" force_save="1" />
                        <field
                            name="invoice_amount"
                            force_save="1"
                            string="Invoice Amount"
                            widget="monetary"
                            options="{'currency_field': 'company_currency_id'}"
                        />
                        <field
                            name="invoice_total"
                            readonly="1"
                            force_save="1"
                            widget="monetary"
                            options="{'currency_field': 'company_currency_id'}"
                        />
                        <field
                            name="retention_amount"
                            readonly="1"
                            force_save="1"
                            widget="monetary"
                            options="{'currency_field': 'company_currency_id'}"
                        />
                        <field name="state" force_save="1" />
                    </list>
                </field>
                <footer>
                    <button string="Save" special="save" class="btn-primary" />
                    <button string="Close" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
