<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.currency.sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tax_totals']" position="attributes">
                <attribute name="widget">tax_totals_company_currency_widget</attribute>
            </xpath>
            <xpath expr="//field[@name='tax_totals']" position="after">
                <field
                    name="total_currencies"
                    widget="total_currencies_widget"
                    nolabel="1"
                    colspan="2"
                />
            </xpath>
        </field>
    </record>
</odoo>
