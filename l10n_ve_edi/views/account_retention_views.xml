<odoo>
    <record id="view_retention_iva_form_l10n_ve_edi" model="ir.ui.view">
        <field name="name">account.retention.iva.form.l10n.ve.edi</field>
        <field name="model">account.retention</field>
        <field name="inherit_id" ref="l10n_ve_withholding.view_retention_iva_form_l10n_ve_withholding"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state'][1]" position="before">
                <button name="action_l10n_ve_edi_send" type="object" string="Enviar retencion digital"
                    class="oe_highlight" icon="fa-upload"
                    invisible="state != 'emitted' or not l10n_ve_edi_show_tab or l10n_ve_edi_send_state != 'not_sent'"/>
                <button name="action_l10n_ve_edi_retry_send" type="object" string="Reintentar envio"
                    icon="fa-refresh"
                    invisible="state != 'emitted' or not l10n_ve_edi_show_tab or l10n_ve_edi_send_state != 'failed'"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="EDI Retencion" name="l10n_ve_edi_retention_tab" invisible="not l10n_ve_edi_show_tab">
                    <group>
                        <group>
                            <field name="l10n_ve_edi_send_state" readonly="1"/>
                            <field name="l10n_ve_edi_sent_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="l10n_ve_edi_payload_attachment_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="l10n_ve_edi_last_error" readonly="1"/>
                        <field name="l10n_ve_edi_response_json" readonly="1" widget="text"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

