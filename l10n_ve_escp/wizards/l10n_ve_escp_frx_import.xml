<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_ve_escp_frx_import_view_form" model="ir.ui.view">
        <field name="name">l10n.ve.escp.frx.import.form</field>
        <field name="model">l10n.ve.escp.frx.import</field>
        <field name="arch" type="xml">
            <form string="Importar reporte FoxPro">
                <group>
                    <group>
                        <field name="name" />
                        <field name="model_id" options="{'no_create': True}" />
                        <field name="detail_expr" placeholder="o.invoice_line_ids" />
                    </group>
                    <group>
                        <field name="frx_file" filename="frx_filename" />
                        <field name="frx_filename" invisible="1" />
                        <field name="frt_file" filename="frt_filename" />
                        <field name="frt_filename" invisible="1" />
                        <field name="cpi" />
                        <field name="lpi" />
                        <field name="paper_height_in" />
                        <field name="import_lines" />
                    </group>
                </group>
                <footer>
                    <button
                        name="action_import"
                        type="object"
                        string="Importar"
                        class="btn-primary"
                    />
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="l10n_ve_escp_frx_import_action" model="ir.actions.act_window">
        <field name="name">Importar reporte FoxPro (.frx)</field>
        <field name="res_model">l10n.ve.escp.frx.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="l10n_ve_escp_frx_import_menu"
        name="Importar reporte FoxPro"
        parent="base.reporting_menuitem"
        action="l10n_ve_escp_frx_import_action"
        sequence="31"
    />
</odoo>
