<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_ve_escp_preview_view_form" model="ir.ui.view">
        <field name="name">l10n.ve.escp.preview.form</field>
        <field name="model">l10n.ve.escp.preview</field>
        <field name="arch" type="xml">
            <form string="Vista previa ESC/P" class="o_l10n_ve_escp_preview_form">
                <field name="report_id" invisible="1" />
                <field name="res_model" invisible="1" />
                <field name="res_ids" invisible="1" />
                <field name="test_mode" invisible="1" />
                <field name="record_count" invisible="1" />
                <field name="preview_html" invisible="1" />
                <field
                    name="preview_pdf"
                    nolabel="1"
                    widget="l10n_ve_escp_preview"
                    options="{'html_field': 'preview_html'}"
                />
                <footer>
                    <button
                        name="action_print"
                        type="object"
                        string="Imprimir"
                        class="btn-primary"
                    />
                    <button string="Cerrar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="l10n_ve_escp_preview_action" model="ir.actions.act_window">
        <field name="name">Vista previa ESC/P</field>
        <field name="res_model">l10n.ve.escp.preview</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="l10n_ve_escp_preview_view_form" />
        <field name="context">{'dialog_size': 'extra-large'}</field>
    </record>
</odoo>
