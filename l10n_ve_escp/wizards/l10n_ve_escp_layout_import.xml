<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_ve_escp_layout_import_view_form" model="ir.ui.view">
        <field name="name">l10n.ve.escp.layout.import.form</field>
        <field name="model">l10n.ve.escp.layout.import</field>
        <field name="arch" type="xml">
            <form string="Importar diseño ESC/P">
                <group>
                    <field name="mode" widget="radio" />
                    <field
                        name="report_id"
                        invisible="mode != 'replace'"
                        required="mode == 'replace'"
                    />
                    <field name="name" invisible="mode != 'new'" required="mode == 'new'" />
                    <field name="layout_file" filename="layout_filename" />
                    <field name="layout_filename" invisible="1" />
                </group>
                <p class="text-muted">
                    El archivo .escp.json se genera con «Exportar diseño» desde el
                    reporte de prueba. Al reemplazar, se borran las bandas actuales
                    y se cargan las del archivo.
                </p>
                <footer>
                    <button
                        name="action_import"
                        type="object"
                        string="Importar"
                        class="btn-primary"
                    />
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="l10n_ve_escp_layout_import_action" model="ir.actions.act_window">
        <field name="name">Importar diseño ESC/P</field>
        <field name="res_model">l10n.ve.escp.layout.import</field>
        <field name="view_mode">form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'form', 'view_id': ref('l10n_ve_escp_layout_import_view_form')})]" />
        <field name="target">new</field>
        <field name="context">{'default_mode': 'new'}</field>
    </record>

    <menuitem
        id="l10n_ve_escp_layout_import_menu"
        name="Importar diseño ESC/P"
        parent="base.reporting_menuitem"
        action="l10n_ve_escp_layout_import_action"
        sequence="32"
    />
</odoo>
