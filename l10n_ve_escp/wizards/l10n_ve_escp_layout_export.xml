<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_ve_escp_layout_export_view_form" model="ir.ui.view">
        <field name="name">l10n.ve.escp.layout.export.form</field>
        <field name="model">l10n.ve.escp.layout.export</field>
        <field name="arch" type="xml">
            <form string="Exportar diseño ESC/P">
                <group>
                    <field name="report_id" readonly="1" />
                </group>
                <p class="text-muted">
                    Se descargará un archivo JSON con bandas, objetos y parámetros
                    del reporte. Impórtelo en producción para replicar el mismo diseño.
                </p>
                <footer>
                    <button
                        name="action_export"
                        type="object"
                        string="Descargar"
                        class="btn-primary"
                    />
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
