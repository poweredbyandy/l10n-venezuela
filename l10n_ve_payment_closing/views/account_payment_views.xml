<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_payment_form" model="ir.ui.view">
        <field name="name">account.payment.form.closing</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_method_line_id']" position="after">
                <field name="closing_id" invisible="not closing_id" />
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_tree" model="ir.ui.view">
        <field name="name">account.payment.list.closing</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="closing_id" optional="hide" />
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_search" model="ir.ui.view">
        <field name="name">account.payment.search.closing</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="closing_id" />
            </xpath>
            <xpath expr="//filter[@name='unmatched']" position="after">
                <filter
                    string="Without Terminal Closing"
                    name="without_closing"
                    domain="[('closing_id', '=', False)]"
                />
            </xpath>
            <xpath expr="//filter[@name='journal']" position="after">
                <filter
                    string="Terminal Closing"
                    name="group_closing"
                    context="{'group_by': 'closing_id'}"
                />
            </xpath>
        </field>
    </record>
</odoo>
