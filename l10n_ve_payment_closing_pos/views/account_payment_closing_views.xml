<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_payment_closing_view_form" model="ir.ui.view">
        <field name="name">account.payment.closing.form.pos</field>
        <field name="model">account.payment.closing</field>
        <field
            name="inherit_id"
            ref="l10n_ve_payment_closing.account_payment_closing_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_method_line_ids']" position="after">
                <field
                    name="pos_payment_method_ids"
                    widget="many2many_tags"
                    readonly="state != 'draft'"
                    options="{'no_create': True}"
                />
            </xpath>
            <xpath
                expr="//field[@name='payment_ids']/list/field[@name='payment_method_line_id']"
                position="after"
            >
                <field name="pos_payment_method_id" optional="show" />
                <field name="pos_session_id" optional="hide" />
            </xpath>
        </field>
    </record>

    <record id="account_payment_closing_view_list" model="ir.ui.view">
        <field name="name">account.payment.closing.list.pos</field>
        <field name="model">account.payment.closing</field>
        <field
            name="inherit_id"
            ref="l10n_ve_payment_closing.account_payment_closing_view_list"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_method_line_ids']" position="after">
                <field
                    name="pos_payment_method_ids"
                    widget="many2many_tags"
                    optional="show"
                />
            </xpath>
        </field>
    </record>
</odoo>
