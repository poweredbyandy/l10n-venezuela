<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="l10n_ve_fiscal_serial.FiscalMachinesAction">
        <Layout display="display">
            <div class="o_fiscal_machines p-3">
                <div class="row g-3">
                    <div class="col-12 col-lg-7">
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-2">
                                    <h3 class="card-title mb-0">Máquinas fiscales</h3>
                                    <div class="d-flex flex-column align-items-end gap-1 text-end" style="max-width: min(100%, 520px);">
                                        <span t-attf-class="badge rounded-pill {{ statusClass }}" t-esc="statusLabel"/>
                                        <span t-if="state.phase === 'connected' and fpMachineLine" class="small text-muted text-break" t-esc="fpMachineLine"/>
                                    </div>
                                </div>
                                <p class="text-muted small mb-3">Web Serial (Chrome/Edge, HTTPS). Los pasos y la consola del navegador registran el mismo flujo.</p>
                                <div class="row g-2 mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label mb-0 small" for="o_fiscal_baud">Baudios</label>
                                        <select id="o_fiscal_baud" class="form-select form-select-sm" t-model="state.serialBaud" t-att-disabled="state.busy or state.phase === 'connected'">
                                            <option value="9600">9600</option>
                                            <option value="19200">19200</option>
                                            <option value="38400">38400</option>
                                            <option value="115200">115200</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label mb-0 small" for="o_fiscal_parity">Paridad</label>
                                        <select id="o_fiscal_parity" class="form-select form-select-sm" t-model="state.serialParity" t-att-disabled="state.busy or state.phase === 'connected'">
                                            <option value="even">8E1 par (TFHKA / DLL)</option>
                                            <option value="none">8N1 sin paridad</option>
                                        </select>
                                    </div>
                                </div>
                                <p class="text-muted small mb-2">
                                    FLAG_21 configurada: <strong><t t-esc="state.flag21"/></strong>
                                </p>
                                <p class="text-muted small mb-2">Si no responde el ENQ, pruebe <strong>8N1</strong> y el baud del manual; el flujo de apertura replica el DLL (DSR/DTR, CTS/RTS, luego ENQ con 5 bytes).</p>
                                <div class="d-flex gap-2 mb-3 flex-wrap">
                                    <button type="button" class="btn btn-primary" t-on-click="onOpenConnection" t-att-disabled="state.busy or state.phase === 'connected'">
                                        Abrir conexión
                                    </button>
                                    <button type="button" class="btn btn-secondary" t-on-click="onCloseConnection" t-att-disabled="state.busy or state.phase !== 'connected'">
                                        Cerrar conexión
                                    </button>
                                </div>
                                <div t-if="state.phase === 'connecting'" class="alert alert-warning py-2 small mb-3" role="status">
                                    Conectando… Si no aparece el selector de puerto, mire si el navegador bloqueó un popup o revise la consola (F12).
                                </div>
                                <div t-if="state.phase === 'connected'" class="alert alert-success py-2 small mb-3" role="status">
                                    Puerto abierto: permanece así hasta que pulse «Cerrar conexión» (no se cierra al enviar comandos ni reportes desde esta pantalla).
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="o_fiscal_cmd_text">Comando (ISO-8859-1 / Latin-1)</label>
                                    <textarea
                                        id="o_fiscal_cmd_text"
                                        class="form-control font-monospace"
                                        rows="5"
                                        placeholder="Solo el cuerpo del comando (sin STX/ETX); una línea = un comando. Ver manual TFHKA."
                                        t-model="state.commandText"
                                        t-att-readonly="state.busy or state.phase !== 'connected'"
                                    />
                                    <p t-if="state.phase !== 'connected'" class="form-text text-muted mb-0">
                                        El campo está bloqueado hasta que el estado muestre «Puerto abierto» (badge verde).
                                    </p>
                                </div>
                                <div class="d-flex gap-2 mb-3 flex-wrap">
                                    <button type="button" class="btn btn-primary" t-on-click="onSendCommand" t-att-disabled="isSendDisabled">
                                        Enviar comando
                                    </button>
                                    <button type="button" class="btn btn-outline-primary" t-on-click="onSendSampleInvoice" t-att-disabled="isSendDisabled">
                                        Secuencia factura de prueba
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary" t-on-click="onSendProbeSeven" t-att-disabled="isSendDisabled">
                                        Probar comando 7 (ACK)
                                    </button>
                                    <button type="button" class="btn btn-outline-info" t-on-click="onReadFpStatusEnq" t-att-disabled="isSendDisabled" title="Comando nativo TFHKA: byte ENQ (0x05); la impresora responde 5 bytes con estado y error fiscal.">
                                        Estado impresora (ENQ)
                                    </button>
                                    <button type="button" class="btn btn-outline-dark" t-on-click="onPrintXReport" t-att-disabled="isSendDisabled">
                                        Reporte X
                                    </button>
                                    <button type="button" class="btn btn-outline-danger" t-on-click="onPrintZReport" t-att-disabled="isSendDisabled">
                                        Reporte Z
                                    </button>
                                    <button type="button" class="btn btn-outline-success" t-on-click="onConfigureFiscalMachine" t-att-disabled="isSendDisabled">
                                        Configurar maquina fiscal
                                    </button>
                                </div>
                                <div t-if="state.lastCmdResult" class="alert alert-secondary mb-3" role="status">
                                    <t t-esc="state.lastCmdResult"/>
                                </div>
                                <div t-if="state.estado" class="alert alert-info mb-0" role="status">
                                    <t t-esc="state.estado"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-5">
                        <div class="card mb-3">
                            <div class="card-header py-2">Registro de sesión</div>
                            <div class="card-body p-2">
                                <pre class="o_fiscal_serial_log mb-0 small font-monospace text-muted" style="max-height: 220px; overflow: auto; white-space: pre-wrap;"><t t-esc="logDisplayText"/></pre>
                            </div>
                        </div>
                        <div class="card">
                            <div class="card-header py-2">Cómo depurar y enviar logs</div>
                            <div class="card-body small">
                                <p class="fw-bold mb-1">En el navegador</p>
                                <ol class="ps-3 mb-3">
                                    <li>Abra <strong>Herramientas de desarrollador</strong> (F12) → pestaña <strong>Consola</strong>.</li>
                                    <li>Recargue la página (F5), opcionalmente filtre por <code>l10n_ve_fiscal_serial</code>.</li>
                                    <li>Pulse «Abrir conexión», elija el puerto y copie las líneas que salgan con el prefijo indicado.</li>
                                </ol>
                                <p class="fw-bold mb-1">En la terminal (Linux, prueba fuera del navegador)</p>
                                <p class="text-muted mb-1">Compruebe que el sistema ve el adaptador y el nombre del dispositivo:</p>
                                <pre class="bg-light p-2 rounded small">ls -l /dev/ttyUSB* /dev/ttyACM* 2>/dev/null; echo "---"; dmesg | tail -15</pre>
                                <p class="text-muted mb-1">Prueba de puerto en bruto (sustituya el dispositivo; 9600 8E1 según TFHKA):</p>
                                <pre class="bg-light p-2 rounded small">picocom -b 9600 --parity E /dev/ttyUSB0
# o: minicom -D /dev/ttyUSB0
# Salida picocom: Ctrl+A Ctrl+X</pre>
                                <p class="fw-bold mb-1">En Windows (CMD o PowerShell)</p>
                                <p class="text-muted mb-1">Listar puertos serie (nombres COM):</p>
                                <pre class="bg-light p-2 rounded small">mode</pre>
                                <p class="text-muted mb-1">O en PowerShell:</p>
                                <pre class="bg-light p-2 rounded small">[System.IO.Ports.SerialPort]::GetPortNames()</pre>
                                <p class="text-muted mb-1">Parámetros del puerto (sustituya COM99 por el suyo; 9600 8E1):</p>
                                <pre class="bg-light p-2 rounded small">mode COM99: BAUD=9600 PARITY=E DATA=8 STOP=1</pre>
                                <p class="text-muted mb-1"><strong>PuTTY y la falta de respuesta:</strong> el puerto puede «abrirse» bien, pero la impresora fiscal contesta al byte <strong>ENQ (0x05)</strong>, no al texto que escribe en la ventana. PuTTY no envía 0x05 al pulsar teclas normales; por eso a menudo no verá nada. Use el script de PowerShell siguiente o un programa con envío hexadecimal (p. ej. Real Term).</p>
                                <p class="text-muted mb-1">Prueba ENQ con PowerShell (cambie COM99; ejecute en consola <strong>como usuario normal</strong>, sin otra app usando el mismo COM):</p>
                                <pre class="bg-light p-2 rounded small">$com = "COM99"
$p = New-Object System.IO.Ports.SerialPort
$p.PortName = $com
$p.BaudRate = 9600
$p.Parity = [System.IO.Ports.Parity]::Even
$p.DataBits = 8
$p.StopBits = [System.IO.Ports.StopBits]::One
$p.ReadTimeout = 3500
$p.Open()
$p.DtrEnable = $true
$p.RtsEnable = $true
Start-Sleep -Milliseconds 500
$p.Write([byte[]]@(0x05), 0, 1)
$deadline = (Get-Date).AddSeconds(4)
$acc = [System.Collections.Generic.List[byte]]::new()
while ((Get-Date) -lt $deadline -and $acc.Count -lt 32) {
  if ($p.BytesToRead -gt 0) {
    $buf = New-Object byte[] $p.BytesToRead
    $n = $p.Read($buf, 0, $buf.Length)
    for ($i = 0; $i -lt $n; $i++) { [void]$acc.Add($buf[$i]) }
  }
  Start-Sleep -Milliseconds 40
}
if ($acc.Count -gt 0) {
  "Recibidos $($acc.Count) bytes: " + [BitConverter]::ToString($acc.ToArray())
} else {
  'Sin bytes en 4 s. Pruebe Parity None (8N1) antes de Open; baud 19200; cable TX/RX; otro adaptador USB.'
}
$p.Close()</pre>
                                <p class="text-muted mb-0">Si este script tampoco recibe bytes, el fallo es de hardware, cable o paridad/baudios, no de Odoo ni del navegador.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </Layout>
    </t>
</templates>
