<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_l10n_ve_fiscal_serial" model="ir.ui.view">
        <field name="name">res.config.settings.l10n.ve.fiscal.serial</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="l10n_ve_seniat.res_config_settings_l10n_ve_seniat"
        />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='l10n_ve_seniat_block']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_right_pane">
                        <separator string="Venezuela - Fiscal Serial" />
                        <group>
                            <field name="l10n_ve_fiscal_serial_flag_21" />
                            <field name="l10n_ve_fiscal_serial_use_emulator" />
                            <field
                                name="l10n_ve_fiscal_serial_send_default_code_in_name"
                            />
                        </group>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
