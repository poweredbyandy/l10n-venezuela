#. module: l10n_ve_fiscal_serial
#. odoo-javascript
#: code:addons/l10n_ve_fiscal_serial/static/src/fiscal_machines/fiscal_machines_action.xml:0
msgid ""
"$com = \"COM99\"\n"
"$p = New-Object System.IO.Ports.SerialPort\n"
"$p.PortName = $com\n"
"$p.BaudRate = 9600\n"
"$p.Parity = [System.IO.Ports.Parity]::Even\n"
"$p.DataBits = 8\n"
"$p.StopBits = [System.IO.Ports.StopBits]::One\n"
"$p.ReadTimeout = 3500\n"
"$p.Open()\n"
"$p.DtrEnable = $true\n"
"$p.RtsEnable = $true\n"
"Start-Sleep -Milliseconds 500\n"
"$p.Write([byte[]]@(0x05), 0, 1)\n"
"$deadline = (Get-Date).AddSeconds(4)\n"
"$acc = [System.Collections.Generic.List[byte]]::new()\n"
"while ((Get-Date) -lt $deadline -and $acc.Count -lt 32) {\n"
"  if ($p.BytesToRead -gt 0) {\n"
"    $buf = New-Object byte[] $p.BytesToRead\n"
"    $n = $p.Read($buf, 0, $buf.Length)\n"
"    for ($i = 0; $i -lt $n; $i++) { [void]$acc.Add($buf[$i]) }\n"
"  }\n"
"  Start-Sleep -Milliseconds 40\n"
"}\n"
"if ($acc.Count -gt 0) {\n"
"  \"Recibidos $($acc.Count) bytes: \" + [BitConverter]::ToString($acc.ToArray())\n"
"} else {\n"
"  'Sin bytes en 4 s. Pruebe Parity None (8N1) antes de Open; baud 19200; cable TX/RX; otro adaptador USB.'\n"
"}\n"
"$p.Close()"
msgstr ""
"$com = \"COM99\"\n"
"$p = Nuevo-Objeto System.IO.Ports.SerialPort\n"
"$p.NombrePuerto = $com\n"
"$p.BaudRate = 9600\n"
"$p.Parity = [System.IO.Ports.Parity]::Incluso\n"
"$p.Bits de datos = 8\n"
"$p.StopBits = [System.IO.Ports.StopBits]::Uno\n"
"$p.ReadTimeout = 3500\n"
"$p.Abrir()\n"
"$p.DtrEnable = $verdadero\n"
"$p.RtsEnable = $verdadero\n"
"Inicio-Sueño-Milisegundos 500\n"
"$p.Escribir([byte[]]@(0x05), 0, 1)\n"
"$ fecha límite = (Obtener-Fecha).AddSeconds(4)\n"
"$acc = [System.Collections.Generic.Lista[byte]]::nuevo()\n"
"while ((Get-Fecha) -lt $fecha límite -y $acc.Conteo -lt 32) {\n"
"  si ($p.BytesToRead -gt 0) {\n"
"    $buf = byte de nuevo objeto[] $p.BytesToRead\n"
"    $n = $p.Read($buf, 0, $buf.Longitud)\n"
"    para ($i = 0; $i -lt $n; $i++) { [void]$acc.Agregar($buf[$i]) }\n"
"  }\n"
"  Inicio-Sueño-Milisegundos 40\n"
"}\n"
"si ($acc.Conteo -gt 0) {\n"
"  \"Recibidos $($acc.Conteo) bytes: \" + [BitConverter]::ToString($acc.ToArray())\n"
"} más {\n"
"  'Sin bytes en 4 s. Pruebe Parity Ninguno (8N1) antes de Abierto; baudios 19200; transmisión por cable/recepción; otro adaptador USB.'\n"
"}\n"
"$p.Cerrar()"

