    <record id="rule_AINCE_empresa_quincenal" model="hr.salary.rule">
      <field name="company_id" eval="False"/>
      <field name="name">Aporte INCES</field>
      <field name="code">APORINCES</field>
      <field name="condition_select">python</field>
      <field name="condition_python">
fechaToStr = str(payslip.date_to)
mesAnioTo = fechaToStr[:7]
diaTo = fechaToStr[-2:]
mesTo = mesAnioTo[-2:]
anioTo = mesAnioTo[:4]
if mesTo in ['03','06','09','12'] and int(diaTo) &gt;= 28:
 result = True
else:
 result = False
            </field>
      <field name="amount_select">code</field>
      <field name="amount_python_compute">
fechaToStr = str(payslip.date_to)
mesAnioTo = fechaToStr[:7]
diaTo = fechaToStr[-2:]
mesTo = mesAnioTo[-2:]
anioTo = mesAnioTo[:4]
mesFrom = str('0' + str(int(mesTo) - 2)) if int(mesTo) &gt; 10 else str(int(mesTo) - 2)
#if mesTo == '03':
# mesFrom = '01'
fechaIniStr = anioTo + '-' + mesFrom + '-' + '01'
SQUIN_sum = payslips.sum('SQUIN', fechaIniStr, to_date=payslip.date_to)
DDESS_sum = payslips.sum('DDESS', fechaIniStr, to_date=payslip.date_to)
DDESD_sum = payslips.sum('DDESD', fechaIniStr, to_date=payslip.date_to)
FERI_sum = payslips.sum('FERI', fechaIniStr, to_date=payslip.date_to)
base = categories.BASIC + categories.SUBS + SQUIN_sum + DDESS_sum + DDESD_sum + FERI_sum
result = base * (employee.company_id.inces_employer_rate/100)
            </field>
      <field name="appears_on_payslip">False</field>
      <field name="category_id" ref="l10n_ve_payroll.hr_salary_rule_category_COMP"/>
      <field name="sequence" eval="203"/>
    </record>
