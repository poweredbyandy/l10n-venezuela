<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="resource_calendar_form_paid_rest" model="ir.ui.view">
        <field name="name">resource.calendar.form.l10n.ve.paid.rest</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.resource_calendar_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='working_hours']" position="after">
                <page
                    string="Non-working paid days"
                    name="l10n_ve_paid_rest_days"
                >
                    <div class="text-muted mb-2">
                        Days that are not worked (no Working Hours) but still
                        count for salary on the payslip. Typical Venezuela:
                        Saturday (DDESS) and Sunday (DDESD).
                    </div>
                    <field name="l10n_ve_paid_rest_day_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="dayofweek" />
                            <field name="name" />
                            <field name="code" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
