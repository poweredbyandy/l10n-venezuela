<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_ve_payroll_social_benefit_view_tree" model="ir.ui.view">
        <field name="name">l10n_ve.payroll.social.benefit.list</field>
        <field name="model">l10n_ve.payroll.social.benefit</field>
        <field name="arch" type="xml">
            <list>
                <field name="date" />
                <field name="name" />
                <field name="employee_id" />
                <field name="benefit_type" />
                <field name="amount" />
                <field name="balance" />
                <field name="source_payslip_id" />
            </list>
        </field>
    </record>
    <record id="l10n_ve_payroll_social_benefit_view_form" model="ir.ui.view">
        <field name="name">l10n_ve.payroll.social.benefit.form</field>
        <field name="model">l10n_ve.payroll.social.benefit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="employee_id" />
                        <field name="date" />
                        <field name="benefit_type" />
                        <field name="amount" />
                        <field name="balance" />
                        <field name="source_payslip_id" />
                        <field name="company_id" groups="base.group_multi_company" />
                        <field name="currency_id" invisible="1" />
                    </group>
                    <field name="interest_ids">
                        <list editable="bottom">
                            <field name="date" />
                            <field name="rate" />
                            <field name="amount" />
                            <field name="source_payslip_id" />
                        </list>
                    </field>
                    <field name="notes" />
                </sheet>
            </form>
        </field>
    </record>
    <record id="l10n_ve_payroll_social_benefit_action" model="ir.actions.act_window">
        <field name="name">Social Benefits</field>
        <field name="res_model">l10n_ve.payroll.social.benefit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
