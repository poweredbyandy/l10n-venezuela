<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="name">Presupuesto / Pedido de venta</field>
        <field name="report_name">l10n_ve_seniat_sale.report_saleorder_ve</field>
        <field name="report_file">l10n_ve_seniat_sale.report_saleorder_ve</field>
        <field
            name="paperformat_id"
            ref="l10n_ve_seniat_sale.paperformat_presupuesto_ve_letter_4cm"
        />
        <field
            name="print_report_name"
        >('Presupuesto - %s' if object.state in ('draft', 'sent') else 'Pedido de Venta - %s') % (object.name,)</field>
    </record>
    <record id="sale.action_report_pro_forma_invoice" model="ir.actions.report">
        <field name="binding_model_id" eval="False" />
    </record>
</odoo>
