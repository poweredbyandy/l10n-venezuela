<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_ve">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-if="o.company_id.account_fiscal_country_id.code != 'VE'">
                    <t t-set="doc" t-value="o" />
                    <t
                        t-call="sale.report_saleorder_document"
                        t-lang="o.partner_id.lang"
                    />
                </t>
                <t t-else="">
                    <t
                        t-call="l10n_ve_seniat_sale.report_saleorder_document_ve"
                        t-lang="o.partner_id.lang"
                    />
                </t>
            </t>
        </t>
    </template>

    <template id="report_saleorder_document_ve">
        <t t-set="lang" t-value="o.partner_id.lang" />
        <t t-if="not company">
            <t t-if="company_id">
                <t t-set="company" t-value="company_id" />
            </t>
            <t t-elif="o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()" />
            </t>
            <t t-else="">
                <t t-set="company" t-value="res_company" />
            </t>
        </t>
        <t t-set="is_quote" t-value="o.state in ('draft', 'sent')" />
        <t t-set="show_taxes_col" t-value="is_quote" />
        <t t-set="show_totals_block" t-value="is_quote" />
        <t t-set="show_section_subtotal" t-value="is_quote" />
        <t t-call="web.html_container">
            <t t-if="not o" t-set="o" t-value="doc" />
            <t t-set="o" t-value="o.with_context(lang=lang)" />
            <div class="header o_l10n_ve_sale_pdf_header">
                <style type="text/css">
                .o_l10n_ve_sale_pdf_header {
                font-size: 12px;
                }
                .o_l10n_ve_sale_pdf_header .l10n_ve_quote_doc_title {
                font-size: 1.65rem !important;
                font-weight: bold !important;
                }
                .o_l10n_ve_sale_pdf_header img.o_l10n_ve_header_logo {
                opacity: 1 !important;
                }
                </style>
                <div class="container-fluid px-0">
                    <div class="mb-2 l10n_ve_sale_company_header">
                        <div class="row align-items-start">
                            <div t-if="company.logo" class="col-auto pe-3">
                                <img
                                    t-att-src="image_data_uri(company.logo)"
                                    class="o_company_logo_big o_l10n_ve_header_logo"
                                    style="max-height: 90px; max-width: 220px;"
                                    alt=""
                                />
                            </div>
                            <div t-attf-class="#{'col' if company.logo else 'col-12'}">
                                <div
                                    class="fw-bold text-uppercase"
                                    t-out="company.name"
                                />
                                <div
                                    t-if="company.vat"
                                    class="text-uppercase"
                                    t-out="company.vat"
                                />
                                <div
                                    class="text-uppercase"
                                    t-out="company.partner_id.contact_address_inline"
                                />
                            </div>
                        </div>
                    </div>
                    <div class="row mb-1">
                        <div class="col-12">
                            <p
                                t-if="is_quote"
                                class="text-start mb-0"
                                style="letter-spacing: 0.02em;"
                            >
                                <span
                                    class="l10n_ve_quote_doc_title fw-bold text-danger text-uppercase"
                                >PRESUPUESTO - <t t-out="o.name"/>
                                </span>
                            </p>
                            <p
                                t-else=""
                                class="text-start mb-0"
                                style="letter-spacing: 0.02em;"
                            >
                                <span
                                    class="l10n_ve_quote_doc_title fw-bold text-danger text-uppercase"
                                >PEDIDO DE VENTA - <t t-out="o.name"/>
                                </span>
                            </p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-9">
                            <span class="d-block text-uppercase">
                                <strong>Razón Social:</strong>
                                <t t-out="o.partner_id.name" />
                            </span>
                            <span class="d-block text-uppercase">
                                <strong>RIF:</strong>
                                <t t-out="o.partner_id.vat" />
                            </span>
                            <span class="d-block text-uppercase">
                                <strong>Dirección:</strong>
                                <t t-out="o.partner_id.contact_address_inline" />
                            </span>
                            <div t-if="o.client_order_ref" class="d-block text-uppercase">
                                <strong>Su referencia:</strong>
                                <span t-field="o.client_order_ref" />
                            </div>
                            <div
                                t-if="o.payment_term_id and o.payment_term_id.note"
                                class="d-block text-uppercase"
                            >
                                <strong>Términos de pago:</strong>
                                <span t-field="o.payment_term_id.note" />
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="d-block text-uppercase fw-bold mb-1">
                                Sin derecho a crédito fiscal
                            </div>
                            <div t-if="not is_quote" class="d-block text-uppercase">
                                <strong>Pedido:</strong>
                                <span t-field="o.name" />
                            </div>
                            <div class="d-block text-uppercase">
                                <strong>Fecha:</strong>
                                <span t-field="o.date_order" t-options='{"widget": "date"}' />
                            </div>
                            <div t-if="o.user_id" class="d-block text-uppercase">
                                <strong>Vendedor:</strong>
                                <span t-field="o.user_id" />
                            </div>
                            <div
                                t-if="o.validity_date and is_quote"
                                class="d-block text-uppercase"
                            >
                                <strong>Válido hasta:</strong>
                                <span t-field="o.validity_date" />
                            </div>
                            <div
                                t-if="o.company_id.taxpayer_type == 'formal'"
                                class="d-block text-center fw-bold mb-0"
                            >Contribuyente Formal</div>
                        </div>
                    </div>
                </div>
            </div>
            <div
                class="article"
                t-att-data-oe-model="o and o._name"
                t-att-data-oe-id="o and o.id"
                t-att-data-oe-lang="o and o.env.context.get('lang')"
            >
            <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat" />
            <style>
                * {
                font-size: 12px !important;
                }
                .l10n_ve_quote_doc_title {
                font-size: 1.65rem !important;
                }
                .l10n_ve_quote_doc_title * {
                font-size: inherit !important;
                }
                .o_l10n_ve_no_fiscal_watermark_repeat {
                font-size: 2.25rem !important;
                line-height: 1.1 !important;
                font-weight: 700 !important;
                font-family: Helvetica, Arial, sans-serif !important;
                text-transform: uppercase !important;
                letter-spacing: 0.08em;
                color: rgba(220, 53, 69, 0.28) !important;
                padding: 0.25rem 0 0.5rem 0;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
                }
                .o_l10n_ve_quote_totals_wrap table.o_total_table {
                width: 100%;
                margin-bottom: 0;
                }
                .o_l10n_ve_quote_totals_wrap table.o_total_table td {
                padding: 0.35rem 0.5rem;
                vertical-align: middle;
                }
                .o_l10n_ve_quote_totals_wrap table.o_total_table tr.o_total td {
                border-top: 2px solid #495057 !important;
                padding-top: 0.65rem !important;
                }
            </style>
            <div class="clearfix invoice_main">
                <div class="page mb-1">
                    <t
                        t-set="lines_to_report"
                        t-value="o._get_order_lines_to_report()"
                    />
                    <t
                        t-set="has_discount"
                        t-value="any(l.discount for l in lines_to_report)"
                    />
                    <t t-set="current_section" t-value="None" />
                    <t t-set="current_subtotal" t-value="0" />
                    <t
                        t-set="l10n_ve_line_cols"
                        t-value="6 + (1 if has_discount else 0) + (1 if show_taxes_col else 0)"
                    />
                    <table
                        class="table table-striped table-sm table-borderless mt-2 table-light"
                    >
                        <thead>
                            <tr class="o_l10n_ve_wmk_head_row">
                                <td
                                    t-att-colspan="l10n_ve_line_cols"
                                    class="border-0 bg-transparent p-0 pb-1"
                                >
                                    <div class="o_l10n_ve_no_fiscal_watermark_repeat text-center">
                                        NO FISCAL
                                    </div>
                                </td>
                            </tr>
                            <tr class="bg-secundary text-white border-bottom">
                                <th class="col text-uppercase fw-bold text-nowrap text-center">#</th>
                                <th class="col text-uppercase fw-bold text-nowrap">Codigo</th>
                                <th class="col-5 text-uppercase fw-bold text-nowrap">Descripcion</th>
                                <th class="col text-uppercase fw-bold text-nowrap text-center">Cant.</th>
                                <th class="col text-uppercase fw-bold text-nowrap text-end">Precio U.</th>
                                <th
                                    t-if="has_discount"
                                    class="col text-uppercase fw-bold text-nowrap"
                                >Desc.</th>
                                <th
                                    t-if="show_taxes_col"
                                    class="col text-uppercase fw-bold text-nowrap"
                                >Impuesto</th>
                                <th class="col-1 text-uppercase fw-bold text-nowrap text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="l10n_ve_line_item" t-value="0" />
                            <t t-foreach="lines_to_report" t-as="line">
                                <t
                                    t-set="current_subtotal"
                                    t-value="current_subtotal + line.price_subtotal"
                                />
                                <tr
                                    t-att-class="'fw-bold o_line_section' if (line.display_type == 'line_section' or line.product_type == 'combo') else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''"
                                >
                                    <t
                                        t-if="not line.display_type and line.product_type != 'combo'"
                                    >
                                        <t
                                            t-set="l10n_ve_line_item"
                                            t-value="l10n_ve_line_item + 1"
                                        />
                                        <td class="text-center text-nowrap">
                                            <span t-out="l10n_ve_line_item" />
                                        </td>
                                        <td>
                                            <span t-field="line.product_id.default_code" />
                                        </td>
                                        <td>
                                            <span t-out="line.l10n_ve_report_line_description()" />
                                        </td>
                                        <td class="text-center text-nowrap">
                                            <span t-field="line.product_uom_qty" />
                                            <span t-field="line.product_uom" />
                                            <span t-if="line.product_packaging_id">
                                                (<span
                                                    t-field="line.product_packaging_qty"
                                                    t-options='{"widget": "integer"}'
                                                />
                                                <span t-field="line.product_packaging_id" />)
                                            </span>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <span t-field="line.price_unit" />
                                        </td>
                                        <td t-if="has_discount" class="text-end">
                                            <span t-field="line.discount" /> %
                                        </td>
                                        <td t-if="show_taxes_col" class="text-end">
                                            <span
                                                t-field="line.tax_id"
                                                options="{'widget': 'many2many_tags'}"
                                            />
                                        </td>
                                        <td
                                            t-if="not line.is_downpayment"
                                            class="text-end"
                                        >
                                            <span t-field="line.price_subtotal" />
                                        </td>
                                    </t>
                                    <t
                                        t-elif="line.display_type == 'line_section' or line.product_type == 'combo'"
                                    >
                                        <td
                                            colspan="100"
                                            class="text-muted bg-light ps-4"
                                        >
                                            <span t-field="line.name" />
                                        </td>
                                        <t t-set="current_section" t-value="line" />
                                        <t t-set="current_subtotal" t-value="0" />
                                    </t>
                                    <t t-elif="line.display_type == 'line_note'">
                                        <td colspan="100" class="text-muted bg-light ps-4">
                                            <span t-field="line.name" />
                                        </td>
                                    </t>
                                </tr>
                                <t
                                    t-if="show_section_subtotal and current_section and (line_last or lines_to_report[line_index+1].display_type == 'line_section' or lines_to_report[line_index+1].product_type == 'combo' or (line.combo_item_id and not lines_to_report[line_index+1].combo_item_id)) and not line.is_downpayment"
                                >
                                    <t t-set="current_section" t-value="None" />
                                    <tr class="is-subtotal text-end">
                                        <td colspan="100">
                                            <strong class="mr16">Subtotal</strong>
                                            <span
                                                t-out="current_subtotal"
                                                t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                            />
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                    <div
                        t-if="show_totals_block"
                        class="row mt-3 align-items-start"
                        name="l10n_ve_quote_terms_and_totals"
                    >
                        <div class="col-6" t-if="o.note" name="l10n_ve_terms_col">
                            <div class="text-uppercase fw-bold mb-1">
                                Términos y condiciones
                            </div>
                            <div class="justify-text">
                                <span t-field="o.note" />
                            </div>
                        </div>
                        <div
                            t-attf-class="col-6#{' ms-auto' if not o.note else ''}"
                            id="total"
                            name="total"
                        >
                            <div class="o_l10n_ve_quote_totals_wrap p-3">
                                <table class="o_total_table table table-sm table-borderless mb-0">
                                    <t t-call="sale.document_tax_totals">
                                        <t t-set="tax_totals" t-value="o.tax_totals" />
                                        <t t-set="currency" t-value="o.currency_id" />
                                    </t>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div
                        t-if="not show_totals_block and o.note"
                        class="clearfix mt-3"
                        name="l10n_ve_terms_conditions"
                    >
                        <div class="text-uppercase fw-bold mb-1">
                            Términos y condiciones
                        </div>
                        <div class="justify-text">
                            <span t-field="o.note" />
                        </div>
                    </div>
                </div>
            </div>
            </div>
            <div class="footer o_l10n_ve_sale_report_footer">
                <div
                    class="o_footer_content border-top pt-2 text-center small"
                >
                    <div
                        t-if="company.report_footer"
                        t-field="company.report_footer"
                    />
                    <div
                        t-if="report_type == 'pdf'"
                        t-attf-class="text-muted {{'mt-1' if company.report_footer else ''}}"
                    >
                        Página <span class="page"/> de <span class="topage"/>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
