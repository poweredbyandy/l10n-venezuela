<?xml version="1.0" encoding="utf-8" ?>
<templates>
    <t t-inherit="account.TaxGroupComponent" t-inherit-mode="extension">
        <xpath expr="//td[hasclass('o_tax_group')]" position="after">
            <td
                t-if="props.totals.display_in_company_currency"
                class="o_list_monetary ps-5 o_tax_totals_company_col"
            >
                <span
                    class="o_tax_group_amount_value o_list_monetary o_tax_totals_company_amount o_account_currency_company_tax"
                    dir="ltr"
                    style="white-space: nowrap;"
                    t-out="formatMonetaryCompany(props.taxGroup.tax_amount)"
                />
            </td>
        </xpath>
    </t>

    <t t-inherit="account.TaxTotalsField" t-inherit-mode="extension">
        <xpath expr="//table" position="before">
            <div
                t-if="totals.display_in_company_currency"
                class="o_account_currency_tax_totals_responsive d-md-none"
            >
                <t t-foreach="totals.subtotals" t-as="subtotal" t-key="subtotal_index">
                    <div class="o_account_currency_tax_totals_line">
                        <span class="o_form_label" t-out="responsiveLabel(subtotal.name, false)"/>
                        <span
                            class="o_list_monetary"
                            t-out="formatMonetary(subtotal.base_amount_currency)"
                        />
                    </div>
                    <div class="o_account_currency_tax_totals_line">
                        <span class="o_form_label" t-out="responsiveLabel(subtotal.name, true)"/>
                        <span
                            class="o_list_monetary"
                            t-out="formatMonetaryCompany(subtotal.base_amount)"
                        />
                    </div>
                    <t t-foreach="subtotal.tax_groups" t-as="taxGroup" t-key="taxGroup_index">
                        <div class="o_account_currency_tax_totals_line">
                            <span
                                class="o_form_label"
                                t-out="responsiveLabel(taxGroup.group_name, false)"
                            />
                            <span
                                class="o_list_monetary"
                                t-out="formatMonetary(taxGroup.tax_amount_currency)"
                            />
                        </div>
                        <div class="o_account_currency_tax_totals_line">
                            <span
                                class="o_form_label"
                                t-out="responsiveLabel(taxGroup.group_name, true)"
                            />
                            <span
                                class="o_list_monetary"
                                t-out="formatMonetaryCompany(taxGroup.tax_amount)"
                            />
                        </div>
                    </t>
                </t>
                <div
                    t-if="'cash_rounding_base_amount_currency' in totals"
                    class="o_account_currency_tax_totals_line"
                >
                    <span class="o_form_label" t-out="responsiveRoundingLabel(false)"/>
                    <span
                        class="o_list_monetary"
                        t-out="formatMonetary(totals.cash_rounding_base_amount_currency)"
                    />
                </div>
                <div
                    t-if="'cash_rounding_base_amount_currency' in totals"
                    class="o_account_currency_tax_totals_line"
                >
                    <span class="o_form_label" t-out="responsiveRoundingLabel(true)"/>
                    <span
                        class="o_list_monetary"
                        t-out="formatMonetaryCompany(totals.cash_rounding_base_amount)"
                    />
                </div>
                <div class="o_account_currency_tax_totals_line o_account_currency_tax_totals_total">
                    <span class="o_form_label" t-out="responsiveTotalLabel(false)"/>
                    <span
                        class="o_list_monetary"
                        t-out="formatMonetary(totals.total_amount_currency)"
                    />
                </div>
                <div class="o_account_currency_tax_totals_line">
                    <span class="o_form_label" t-out="responsiveTotalLabel(true)"/>
                    <span
                        class="o_list_monetary"
                        t-out="formatMonetaryCompany(totals.total_amount)"
                    />
                </div>
            </div>
        </xpath>
        <xpath expr="//table" position="attributes">
            <attribute name="t-att-class">
                {
                    'o_account_currency_tax_totals': totals.display_in_company_currency,
                    'd-none': totals.display_in_company_currency,
                    'd-md-table': totals.display_in_company_currency,
                }
            </attribute>
        </xpath>
        <xpath
            expr="//t[@t-foreach='totals.subtotals']/tr[1]/td[hasclass('o_list_monetary')]"
            position="after"
        >
            <td
                t-if="totals.display_in_company_currency"
                class="o_list_monetary ps-5 o_tax_totals_company_col"
            >
                <span
                    class="o_list_monetary o_tax_totals_company_amount o_account_currency_company_subtotal"
                    t-att-name="subtotal.name + '_company'"
                    style="white-space: nowrap; font-weight: bold;"
                    dir="ltr"
                    t-out="formatMonetaryCompany(subtotal.base_amount)"
                />
            </td>
        </xpath>
        <xpath expr="//tr[.//span[@name='amount_total']]/td[hasclass('o_list_monetary')]" position="after">
            <td
                t-if="totals.display_in_company_currency"
                class="o_list_monetary ps-5 o_tax_totals_company_col"
            >
                <span
                    class="o_list_monetary o_tax_totals_company_amount o_account_currency_company_total"
                    name="amount_total_company"
                    style="font-size: 1.3em; font-weight: bold; white-space: nowrap;"
                    dir="ltr"
                    t-out="formatMonetaryCompany(totals.total_amount)"
                />
            </td>
        </xpath>
    </t>
</templates>
