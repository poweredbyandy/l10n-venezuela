<?xml version="1.0" encoding="utf-8" ?>
<templates>
    <t t-inherit="account.TaxGroupComponent" t-inherit-mode="extension">
        <xpath expr="//td[hasclass('o_tax_group')]" position="after">
            <td
                t-if="props.totals.display_in_company_currency"
                class="o_list_monetary ps-5 o_tax_totals_company_col"
            >
                <span
                    class="o_tax_group_amount_value o_list_monetary o_tax_totals_company_amount o_account_currency_company_tax"
                    dir="ltr"
                    style="white-space: nowrap;"
                    t-out="formatMonetaryCompany(props.taxGroup.tax_amount)"
                />
            </td>
        </xpath>
    </t>

    <t t-inherit="account.TaxTotalsField" t-inherit-mode="extension">
        <xpath expr="//table" position="attributes">
            <attribute name="t-att-class">
                {'o_account_currency_tax_totals': totals.display_in_company_currency}
            </attribute>
        </xpath>
        <xpath
            expr="//t[@t-foreach='totals.subtotals']/tr[1]/td[hasclass('o_list_monetary')]"
            position="after"
        >
            <td
                t-if="totals.display_in_company_currency"
                class="o_list_monetary ps-5 o_tax_totals_company_col"
            >
                <span
                    class="o_list_monetary o_tax_totals_company_amount o_account_currency_company_subtotal"
                    t-att-name="subtotal.name + '_company'"
                    style="white-space: nowrap; font-weight: bold;"
                    dir="ltr"
                    t-out="formatMonetaryCompany(subtotal.base_amount)"
                />
            </td>
        </xpath>
        <xpath expr="//tr[.//span[@name='amount_total']]/td[hasclass('o_list_monetary')]" position="after">
            <td
                t-if="totals.display_in_company_currency"
                class="o_list_monetary ps-5 o_tax_totals_company_col"
            >
                <span
                    class="o_list_monetary o_tax_totals_company_amount o_account_currency_company_total"
                    name="amount_total_company"
                    style="font-size: 1.3em; font-weight: bold; white-space: nowrap;"
                    dir="ltr"
                    t-out="formatMonetaryCompany(totals.total_amount)"
                />
            </td>
        </xpath>
    </t>
</templates>
