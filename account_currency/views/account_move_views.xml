<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.account.currency</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='tax_lock_date_message']/parent::div"
                position="after"
            >
                <div
                    class="alert alert-warning d-flex align-items-center flex-wrap gap-2"
                    role="alert"
                    invisible="state != 'draft' or move_type == 'entry' or currency_id == company_currency_id or not l10n_ve_currency_rate_outdated"
                >
                    <span>
                        La tasa de cambio de esta factura no coincide con la tasa
                        vigente para la fecha del documento.
                    </span>
                    <button
                        type="object"
                        name="refresh_invoice_currency_rate"
                        string="Recalcular tasa"
                        class="btn btn-link p-0"
                    />
                </div>
                <field name="l10n_ve_currency_rate_outdated" invisible="1" />
            </xpath>
            <xpath expr="//div[@name='currency_conversion_div']" position="after">
                <div
                    class="d-flex gap-1 text-muted mt-1"
                    invisible="currency_id == company_currency_id or not l10n_ve_inverse_rate"
                >
                    <span>1</span>
                    <field
                        name="currency_id"
                        readonly="True"
                        options="{'no_open': True}"
                        class="w-auto"
                    />
                    <span>=</span>
                    <field
                        name="l10n_ve_inverse_rate"
                        digits="[12,6]"
                        readonly="True"
                    />
                    <field
                        name="company_currency_id"
                        readonly="True"
                        options="{'no_open': True}"
                        class="w-auto"
                    />
                </div>
            </xpath>
            <xpath expr="//field[@name='tax_totals']/.." position="after">
                <field name="lines_with_rate_difference" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//list" position="attributes">
                <attribute name="decoration-danger">warning_rate_difference</attribute>
            </xpath>
            <xpath
                expr="//field[@name='invoice_line_ids']//list//field[@name='price_subtotal']"
                position="after"
            >
                <field
                    name="price_subtotal_currency"
                    column_invisible="parent.currency_id == parent.company_currency_id"
                />
                <field name="warning_rate_difference" column_invisible="1" />
                <field name="has_rate_difference" column_invisible="1" />
                <field name="manually_price_subtotal_currency" column_invisible="1" />
                <button
                    name="reset_price_subtotal_currency"
                    string="Reset"
                    type="object"
                    icon="fa-refresh"
                    invisible="not has_rate_difference"
                    column_invisible="not parent.lines_with_rate_difference"
                />
                <field
                    name="currency_rate"
                    string="Exchange Rate"
                    optional="hide"
                    readonly="0"
                    digits="[16,16]"
                />
            </xpath>
        </field>
    </record>
</odoo>
