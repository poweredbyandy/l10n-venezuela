<odoo>
    <!-- Template para Notas de Entrega (Stock Pickings) -->
    <template
        id="report_delivery_document_inherit_l10n_ve_stock"
        inherit_id="stock.report_delivery_document"
    >
        <xpath expr="//div[@id='informations']" position="inside">
            <div class="col" t-if="o.company_id.account_fiscal_country_id.code == 'VE'">
                <strong>Sin derecho a crédito fiscal.</strong>
            </div>
        </xpath>
    </template>
</odoo>
