<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_l10n_ve" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.l10n.ve</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_title']" position="after">
                <field name="l10n_ve_is_ve_country" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='picking_type_id']" position="after">
                <field
                    name="l10n_ve_internal_transfer_reason_id"
                    string="Motivo de traslado"
                    context="{'default_company_id': company_id}"
                    invisible="not l10n_ve_is_ve_country or picking_type_code != 'internal'"
                    required="l10n_ve_is_ve_country and picking_type_code == 'internal' and state != 'draft'"
                />
            </xpath>
            <xpath
                expr="//field[@name='partner_id'][@nolabel='1']"
                position="after"
            >
                <field
                    name="l10n_ve_partner_contact_phone_display"
                    readonly="1"
                    invisible="not l10n_ve_is_ve_country or not partner_id"
                />
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field
                    name="l10n_ve_sales_user_id"
                    readonly="1"
                    invisible="not l10n_ve_is_ve_country or not sale_id"
                />
                <field
                    name="l10n_ve_transport_partner_id"
                    invisible="not l10n_ve_is_ve_country or picking_type_code != 'outgoing'"
                />
                <field
                    name="l10n_ve_fleet_vehicle_id"
                    invisible="not l10n_ve_is_ve_country or picking_type_code != 'outgoing'"
                />
            </xpath>
            <xpath
                expr="//div[@class='o_td_label'][label[@for='partner_id']]"
                position="before"
            >
                <div
                    class="o_td_label"
                    invisible="not l10n_ve_is_ve_country or picking_type_code == 'internal'"
                >
                    <label
                        for="l10n_ve_control_number"
                        class="text-danger"
                    >N° Control:</label>
                </div>
                <field
                    name="l10n_ve_control_number"
                    class="text-danger"
                    placeholder="00-00000000-0"
                    nolabel="1"
                    invisible="not l10n_ve_is_ve_country or picking_type_code == 'internal'"
                    readonly="picking_type_code == 'outgoing' or state in ('done', 'cancel')"
                />
            </xpath>
            <xpath expr="//field[@name='picking_properties']" position="before">
                <group
                    string="Precios guía (sin pedido de venta)"
                    invisible="not l10n_ve_is_ve_country or picking_type_code != 'outgoing' or sale_id"
                >
                    <field name="l10n_ve_dispatch_pricelist_id" />
                    <field name="l10n_ve_dispatch_currency_id" />
                    <field name="l10n_ve_dispatch_amount_total" />
                </group>
            </xpath>
            <xpath expr="//sheet/notebook" position="after">
                <div
                    class="d-flex justify-content-end pt-3 mt-2 w-100"
                    invisible="not l10n_ve_is_ve_country or picking_type_code != 'outgoing'"
                >
                    <field name="l10n_ve_dispatch_display_currency_id" invisible="1" />
                    <div
                        class="fs-2 fw-bold"
                        style="display: grid; grid-template-columns: max-content max-content; column-gap: 0.75rem; row-gap: 0.15rem; justify-items: end;"
                    >
                        <span>Subtotal:</span>
                        <field
                            name="l10n_ve_dispatch_display_subtotal"
                            nolabel="1"
                            readonly="1"
                            class="text-end m-0"
                        />
                        <span>Total:</span>
                        <field
                            name="l10n_ve_dispatch_display_total"
                            nolabel="1"
                            readonly="1"
                            class="text-end m-0"
                        />
                    </div>
                </div>
            </xpath>
            <xpath
                expr="//field[@name='move_ids_without_package']/list/field[@name='quantity']"
                position="after"
            >
                <field name="l10n_ve_dispatch_currency_id" column_invisible="1" />
                <field
                    name="l10n_ve_dispatch_price_unit"
                    readonly="1"
                    optional="show"
                    column_invisible="parent.picking_type_code != 'outgoing' or not parent.l10n_ve_is_ve_country"
                />
                <field
                    name="l10n_ve_dispatch_subtotal"
                    readonly="1"
                    optional="show"
                    column_invisible="parent.picking_type_code != 'outgoing' or not parent.l10n_ve_is_ve_country"
                />
                <field
                    name="l10n_ve_dispatch_tax_ids"
                    widget="many2many_tags"
                    readonly="1"
                    optional="show"
                    column_invisible="parent.picking_type_code != 'outgoing' or not parent.l10n_ve_is_ve_country"
                />
                <field
                    name="l10n_ve_dispatch_price_total"
                    readonly="1"
                    optional="show"
                    column_invisible="parent.picking_type_code != 'outgoing' or not parent.l10n_ve_is_ve_country"
                />
            </xpath>
        </field>
    </record>

    <record id="stock_picking_tree_inherit_l10n_ve" model="ir.ui.view">
        <field name="name">stock.picking.list.inherit.l10n.ve</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field
                    name="l10n_ve_control_number"
                    string="N° control"
                    optional="show"
                />
            </xpath>
        </field>
    </record>

    <record id="stock_picking_search_inherit_l10n_ve" model="ir.ui.view">
        <field name="name">stock.picking.internal.search.inherit.l10n.ve</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="l10n_ve_control_number" string="N° control" />
            </xpath>
            <xpath expr="//filter[@name='delivery']" position="after">
                <filter
                    name="l10n_ve_dispatch_guides_with_control"
                    string="Guías de despacho (con N° control)"
                    domain="['&amp;', '&amp;', ('picking_type_code', '=', 'outgoing'), ('l10n_ve_control_number', '!=', False), ('l10n_ve_control_number', '!=', '')]"
                />
            </xpath>
        </field>
    </record>
</odoo>