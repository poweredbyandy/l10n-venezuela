<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="l10n_ve_reports.AgedReceivableFilterAccounts">
        <Dropdown menuClass="'account_report_filter receivable_accounts'">
            <button class="btn btn-secondary">
                <i class="fa fa-book me-1" />Cuentas por cobrar
            </button>

            <t t-set-slot="content">
                <div class="dropdown-item gap-2 align-items-center">
                    <label>Cuentas por cobrar</label>
                    <MultiRecordSelector
                        t-props="getMultiRecordSelectorProps('account.account', 'account_ids')"
                        domain="receivableAccountDomain"
                    />
                </div>
            </t>
        </Dropdown>
    </t>
</templates>
