<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="l10n_ve_reports.AccountReportFilterDisplayCurrency">
        <div class="d-flex gap-1 align-items-center">
            <Dropdown
                menuClass="'account_report_filter display_currency'"
                onStateChanged="(isOpen) => !isOpen ? this.applyFilters('display_currency') : null"
            >
                <button class="btn btn-secondary">
                    <i class="fa fa-money me-1" />
                    <t t-out="selectedDisplayCurrencyName" />
                </button>

                <t t-set-slot="content">
                    <t
                        t-foreach="controller.options.available_currencies"
                        t-as="currency"
                        t-key="currency.id"
                    >
                        <DropdownItem
                            class="{ 'selected': (controller.options.display_currency_id == currency.id) }"
                            onSelected="() => this.filterDisplayCurrency(currency.id)"
                        >
                            <t t-out="currency.name + ' (' + currency.symbol + ')'" />
                        </DropdownItem>
                    </t>
                </t>
            </Dropdown>

            <!-- Currency Rate Date Type Selector -->
            <Dropdown
                menuClass="'account_report_filter currency_rate_date_type'"
                onStateChanged="(isOpen) => !isOpen ? this.applyFilters('currency_rate_date_type') : null"
            >
                <button class="btn btn-secondary">
                    <i class="fa fa-calendar me-1" />
                    <t t-out="selectedCurrencyRateDateTypeName" />
                </button>

                <t t-set-slot="content">
                    <DropdownItem
                        class="{ 'selected': (controller.options.currency_rate_date_type == 'document') }"
                        onSelected="() => this.filterCurrencyRateDateType('document')"
                    >
                        <t t-out="currencyRateDateTypeLabel('document')" />
                    </DropdownItem>
                    <DropdownItem
                        class="{ 'selected': (controller.options.currency_rate_date_type == 'current') }"
                        onSelected="() => this.filterCurrencyRateDateType('current')"
                    >
                        <t t-out="currencyRateDateTypeLabel('current')" />
                    </DropdownItem>
                    <DropdownItem
                        class="{ 'selected': (controller.options.currency_rate_date_type == 'manual') }"
                        onSelected="() => this.filterCurrencyRateDateType('manual')"
                    >
                        <t t-out="currencyRateDateTypeLabel('manual')" />
                    </DropdownItem>
                </t>
            </Dropdown>

            <!-- Manual Date Selector (only shown when currency_rate_date_type is 'manual') -->
            <t t-if="controller.options.currency_rate_date_type == 'manual'">
                <DateTimeInput
                    type="'date'"
                    value="currencyRateDateValue"
                    onChange="(date) => this.onCurrencyRateDateChanged(date)"
                />
            </t>
        </div>
    </t>
</templates>
