<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="l10n_ve_reports.DailyPaymentsReportFilterDateType">
        <Dropdown menuClass="'account_report_filter daily_payments_date_type'">
            <button class="btn btn-secondary">
                <i class="fa fa-filter me-1" />
                <t t-out="dailyPaymentsDateTypeLabel" />
            </button>

            <t t-set-slot="content">
                <DropdownItem
                    class="{ 'selected': controller.options.daily_payments_date_type === 'validation' }"
                    onSelected="() => this.filterDailyPaymentsDateType('validation')"
                >
                    <t t-out="dailyPaymentsDateTypeOptionLabel('validation')" />
                </DropdownItem>
                <DropdownItem
                    class="{ 'selected': controller.options.daily_payments_date_type === 'payment' }"
                    onSelected="() => this.filterDailyPaymentsDateType('payment')"
                >
                    <t t-out="dailyPaymentsDateTypeOptionLabel('payment')" />
                </DropdownItem>
            </t>
        </Dropdown>
    </t>

    <t
        t-name="l10n_ve_reports.DailyPaymentsReportFiltersCustomizable"
        t-inherit="l10n_ve_reports.AccountReportFiltersCustomizable"
    >
        <xpath expr="//div[@id='filter_date']" position="before">
            <t t-if="'daily_payments_date_type' in controller.options">
                <div id="filter_daily_payments_date_type">
                    <t t-call="l10n_ve_reports.DailyPaymentsReportFilterDateType" />
                </div>
            </t>
        </xpath>
    </t>
</templates>
