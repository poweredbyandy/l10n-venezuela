<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_bank_statement_line_kanban_auto_reconcile" model="ir.ui.view">
        <field name="name">account.bank.statement.line.kanban.auto.reconcile</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id" ref="account_accountant.view_bank_statement_line_kanban_bank_rec_widget" />
        <field name="arch" type="xml">
            <xpath expr="//kanban/templates" position="before">
                <header>
                    <button
                        name="action_queue_ref_auto_reconcile"
                        type="object"
                        string="Conciliar automáticamente"
                        display="always"
                        class="btn-primary"
                        groups="account.group_account_user"
                    />
                </header>
            </xpath>
        </field>
    </record>

    <record id="view_bank_statement_line_list_auto_reconcile" model="ir.ui.view">
        <field name="name">account.bank.statement.line.list.auto.reconcile</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id" ref="account_accountant.view_bank_statement_line_tree_bank_rec_widget" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button
                        name="action_queue_ref_auto_reconcile"
                        type="object"
                        string="Conciliar automáticamente"
                        display="always"
                        class="btn-primary"
                        groups="account.group_account_user"
                    />
                </header>
            </xpath>
        </field>
    </record>
</odoo>
