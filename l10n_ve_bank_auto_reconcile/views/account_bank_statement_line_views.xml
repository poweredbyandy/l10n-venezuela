<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_bank_statement_line_kanban_auto_reconcile" model="ir.ui.view">
        <field name="name">account.bank.statement.line.kanban.auto.reconcile</field>
        <field name="model">account.bank.statement.line</field>
        <field
            name="inherit_id"
            ref="account_accountant.view_bank_statement_line_kanban_bank_rec_widget"
        />
        <field name="arch" type="xml">
            <xpath expr="//kanban/templates" position="before">
                <header>
                    <button
                        name="action_queue_ref_auto_reconcile"
                        type="object"
                        string="Conciliar automáticamente"
                        display="always"
                        class="btn-primary"
                        groups="account.group_account_user"
                    />
                    <button
                        name="action_open_reference_reconcile_queue"
                        type="object"
                        string="Ver cola"
                        display="always"
                        groups="account.group_account_user"
                    />
                </header>
            </xpath>
        </field>
    </record>

    <record id="view_bank_statement_line_list_auto_reconcile" model="ir.ui.view">
        <field name="name">account.bank.statement.line.list.auto.reconcile</field>
        <field name="model">account.bank.statement.line</field>
        <field
            name="inherit_id"
            ref="account_accountant.view_bank_statement_line_tree_bank_rec_widget"
        />
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button
                        name="action_queue_ref_auto_reconcile"
                        type="object"
                        string="Conciliar automáticamente"
                        display="always"
                        class="btn-primary"
                        groups="account.group_account_user"
                    />
                    <button
                        name="action_open_reference_reconcile_queue"
                        type="object"
                        string="Ver cola"
                        display="always"
                        groups="account.group_account_user"
                    />
                </header>
            </xpath>
        </field>
    </record>

    <record
        id="account_bank_statement_line_view_search_auto_reconcile"
        model="ir.ui.view"
    >
        <field name="name">account.bank.statement.line.search.auto.reconcile</field>
        <field name="model">account.bank.statement.line</field>
        <field
            name="inherit_id"
            ref="account_accountant.view_bank_statement_line_search_bank_rec_widget"
        />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='not_matched']" position="after">
                <filter
                    name="in_auto_reconcile_queue"
                    string="En cola"
                    domain="[('in_auto_reconcile_queue', '=', True)]"
                />
            </xpath>
        </field>
    </record>

    <record id="action_bank_auto_reconcile_queue" model="ir.actions.server">
        <field name="name">Cola de conciliación bancaria</field>
        <field name="model_id" ref="account.model_account_bank_statement_line" />
        <field name="state">code</field>
        <field
            name="code"
        >action = model.action_open_reference_reconcile_queue()</field>
    </record>

    <menuitem
        id="menu_bank_auto_reconcile_queue"
        name="Cola de conciliación bancaria"
        parent="account.menu_finance_entries"
        action="action_bank_auto_reconcile_queue"
        sequence="66"
        groups="account.group_account_user"
    />
</odoo>
