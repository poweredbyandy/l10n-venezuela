<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_ve_default_account_view_form" model="ir.ui.view">
        <field name="name">l10n_ve.default.account.form</field>
        <field name="model">l10n_ve.default.account</field>
        <field name="arch" type="xml">
            <form string="Cuentas por defecto" create="false" delete="false">
                <sheet>
                    <group>
                        <field name="company_id" invisible="1" />
                        <field name="commission_account_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_ve_default_accounts" model="ir.actions.server">
        <field name="name">Cuentas por defecto</field>
        <field name="model_id" ref="model_l10n_ve_default_account" />
        <field name="state">code</field>
        <field name="code">action = model.action_open_default_accounts()</field>
    </record>

    <menuitem
        id="menu_l10n_ve_default_accounts"
        name="Cuentas por defecto"
        parent="account.account_account_menu"
        action="action_l10n_ve_default_accounts"
        sequence="6"
        groups="account.group_account_manager"
    />
</odoo>
