<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_accountant.auto_reconcile_bank_statement_line" model="ir.cron">
        <field name="active" eval="False" />
    </record>

    <record id="ir_cron_bank_reconcile_queue" model="ir.cron">
        <field name="name">Conciliación bancaria: procesar cola</field>
        <field name="model_id" ref="model_l10n_ve_bank_reconcile_queue" />
        <field name="state">code</field>
        <field name="code">model._cron_process_queue()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
    </record>
</odoo>
