<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="l10n_ve_pos_igtf.PaymentScreenDue"
        t-inherit="point_of_sale.PaymentScreenDue"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('total')]" position="after">
            <div
                t-if="currentOrder.company and currentOrder.company.l10n_ve_igtf_feature_active and currentOrder.is_to_invoice() and currentOrder.igtf_amount"
                class="text-center py-2 border-top border-secondary-subtle"
            >
                <div class="small text-muted">
                    IGTF (<t t-esc="currentOrder.company.l10n_ve_igtf_percent" />%)
                </div>
                <div class="fw-semibold text-warning">
                    + <t t-esc="env.utils.formatCurrency(currentOrder.igtf_amount)" />
                </div>
                <div class="small text-muted mt-1">
                    Total con IGTF:
                    <strong
                    class="text-success ms-1"
                    t-esc="env.utils.formatCurrency(currentOrder.get_total_with_tax())"
                />
                </div>
            </div>
        </xpath>
    </t>
</templates>
