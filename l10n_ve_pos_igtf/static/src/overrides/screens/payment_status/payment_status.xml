<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos_igtf.PaymentScreenStatus" t-inherit="point_of_sale.PaymentScreenStatus" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-status-container')]" position="after">
            <div t-if="l10nVePosShowIgtfFooter" class="border-top pt-2 mt-2 small text-center">
                <div class="text-muted">
                    Base IGTF (orden):
                    <strong t-esc="env.utils.formatCurrency(props.order.bi_igtf)"/>
                </div>
                <div class="text-warning fw-semibold">
                    IGTF:
                    <span t-esc="env.utils.formatCurrency(props.order.igtf_amount)"/>
                </div>
            </div>
        </xpath>
    </t>
</templates>
