<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="l10n_ve_seniat.SeniatInvoiceDashboard">
        <div
            t-if="state.visible"
            class="o_l10n_ve_invoice_dashboard d-none d-md-flex border-bottom bg-view"
        >
            <t t-foreach="state.items" t-as="item" t-key="item.key">
                <div
                    class="o_l10n_ve_invoice_dashboard_card flex-grow-1 d-flex flex-column border-0 rounded-0"
                    t-att-class="item.key === 'unfactured_dispatch_guides' ? 'o_l10n_ve_invoice_dashboard_card--dispatch' : ''"
                >
                    <button
                        type="button"
                        class="btn flex-grow-1 d-flex flex-column p-3 text-center border-0 rounded-0 bg-transparent"
                        t-att-data-key="item.key"
                        t-on-click="() => this.openItem(item.key)"
                    >
                        <span
                            class="o_l10n_ve_invoice_dashboard_count h2 m-0 mb-1"
                            t-out="item.count"
                        />
                        <span
                            class="o_l10n_ve_invoice_dashboard_label fw-semibold"
                            t-out="item.label"
                        />
                        <span
                            t-if="item.show_month_label and state.monthLabel"
                            class="o_l10n_ve_invoice_dashboard_period text-muted small"
                            t-out="state.monthLabel"
                        />
                    </button>
                    <div
                        t-if="item.key === 'unfactured_dispatch_guides' and state.dispatchEmail.available"
                        class="o_l10n_ve_invoice_dashboard_mail px-3 pb-2 d-flex align-items-center justify-content-center gap-2"
                    >
                        <span
                            t-if="state.dispatchEmail.lastSentLabel"
                            class="text-muted small"
                            title="Último envío de correo"
                        >
                            <i class="fa fa-envelope-o me-1" />
                            <t t-out="state.dispatchEmail.lastSentLabel" />
                        </span>
                        <span t-else="" class="text-muted small">Sin envíos</span>
                        <button
                            type="button"
                            class="btn btn-link btn-sm p-0 o_l10n_ve_invoice_dashboard_reload"
                            title="Enviar listado por correo"
                            t-att-disabled="!state.dispatchEmail.canSend or state.sendingDispatchEmail"
                            t-on-click="sendDispatchEmail"
                        >
                            <i
                                t-att-class="state.sendingDispatchEmail ? 'fa fa-refresh fa-spin' : 'fa fa-refresh'"
                            />
                        </button>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
