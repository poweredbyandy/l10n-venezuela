<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account.account_invoices" model="ir.actions.report">
        <field name="binding_model_id" eval="False" />
    </record>
    <record id="account.account_invoices_without_payment" model="ir.actions.report">
        <field name="binding_model_id" eval="False" />
    </record>

    <template
        id="document_tax_totals_company_currency_template"
        inherit_id="account.document_tax_totals_company_currency_template"
    >
        <xpath
            expr="//div[hasclass('totals_taxes_company_currency')]"
            position="attributes"
        >
            <attribute name="class">mb-2</attribute>
        </xpath>
        <!-- <xpath expr="//p[hasclass('tax_computation_company_currency')]" priority="100" position="replace" /> -->
    </template>

    <template id="report_invoice_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang" />
                <t t-if="not o" t-set="o" t-value="doc" />
                <t t-if="not company">
                    <!-- Multicompany -->
                    <t t-if="company_id">
                        <t t-set="company" t-value="company_id" />
                    </t>
                    <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                        <t t-set="company" t-value="o.company_id.sudo()" />
                    </t>
                    <t t-else="else">
                        <t t-set="company" t-value="res_company" />
                    </t>
                </t>

                <t t-call="web.basic_layout">
                    <t t-set="o" t-value="o.with_context(lang=lang)" />
                    <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat" />
                    <style>
                    * {
                        font-size: 12px !important;
                    }
                    </style>
                    <!-- So that it appears in the footer of the report instead of the company VAT if it's set -->
                    <div class="row">
                        <p class="text-center fw-bold text-danger">
                            <span
                                t-if="o.move_type == 'out_invoice' and not o.debit_origin_id"
                            >FACTURA</span>
                            <span
                                t-elif="o.move_type == 'out_invoice' and o.debit_origin_id"
                            >NOTA DE DEBITO</span>
                            <span
                                t-elif="o.move_type == 'out_refund' and o.reversed_entry_id"
                            >NOTA DE CREDITO</span>
                        </p>
                    </div>
                    <div class="row">
                        <t
                            t-if="o.debit_origin_id"
                            t-set="origin_affected"
                            t-value="o.debit_origin_id"
                        />
                        <t
                            t-if="o.reversed_entry_id"
                            t-set="origin_affected"
                            t-value="o.reversed_entry_id"
                        />
                        <div
                            t-attf-class="{{ 'col-6' if origin_affected else 'col-9' }}"
                        >
                            <t
                                t-if="o.l10n_ve_on_behalf_of_third_party and o.l10n_ve_third_party_partner_id"
                            >
                                <span
                                    class="d-block text-uppercase fw-bold"
                                >FACTURA POR CUENTA DE TERCEROS:</span>
                                <span class="d-block"><t
                                    t-out="o.l10n_ve_third_party_partner_id.name"
                                /> - RIF: <t
                                    t-out="o.l10n_ve_third_party_partner_id.vat"
                                /></span>
                                <div
                                    t-if="o.l10n_ve_certified_copy_deadline"
                                    class="text-muted small mb-2"
                                >
                                    <span
                                >Obligación Art. 32 PA00071: Entregar copia certificada al cliente a más tardar el <span
                                    t-field="o.l10n_ve_certified_copy_deadline"
                                /></span>.
                                </div>
                            </t>
                            <span class="d-block text-uppercase">
                                <strong>Razón Social:</strong>
                                <t t-out="o.partner_id.name" />
                            </span>
                            <span class="d-block text-uppercase">
                                <strong>RIF:</strong>
                                <t t-out="o.partner_id.vat" />
                            </span>
                            <span class="d-block text-uppercase">
                                <strong>Dirección:</strong>
                                <t t-out="o.partner_id.contact_address_inline" />
                            </span>
                            <div t-if="o.ref" class="d-block text-uppercase">
                                <strong>Referencia:</strong>
                                <span t-field="o.ref" />
                            </div>
                            <div
                                t-if="o.invoice_payment_term_id.note"
                                class="d-block text-uppercase"
                            >
                                <strong>Términos de pago:</strong>
                                <span t-field="o.invoice_payment_term_id.note" />
                            </div>
                        </div>
                        <div t-if="origin_affected" class="col-3">
                            <div class="text-muted">
                                <div
                                    class="d-block text-uppercase"
                                >Documento afectado</div>
                                <div class="d-block text-uppercase">
                                    <strong>Factura:</strong>
                                    <span t-field="origin_affected.name" />
                                </div>
                                <div class="d-block text-uppercase">
                                    <strong>N° de Control:</strong>
                                    <span
                                        t-field="origin_affected.l10n_ve_control_number"
                                    />
                                </div>
                                <div class="d-block text-uppercase">
                                    <strong>Fecha:</strong>
                                    <span
                                        t-field="origin_affected.l10n_ve_invoice_date"
                                    />
                                </div>
                            </div>
                        </div>
                        <div class="col-3">
                            <br />
                            <div class="d-block text-uppercase">
                                <strong
                                    t-if="o.move_type == 'out_refund'"
                                >Nota de Crédito:</strong>
                                <strong
                                    t-elif="o.move_type == 'out_invoice' and o.debit_origin_id"
                                >Nota de Débito:</strong>
                                <strong t-else="">Factura:</strong>
                                <span t-field="o.name" />
                            </div>
                            <div class="d-block text-uppercase">
                                <strong>Fecha:</strong>
                                <span t-field="o.l10n_ve_invoice_date" />
                            </div>
                            <div class="d-block text-uppercase">
                                <strong>Vencimiento:</strong>
                                <span t-field="o.invoice_date_due" />
                            </div>
                            <div
                                t-if="o.company_id.taxpayer_type == 'formal'"
                                class="d-block text-center fw-bold mb-2"
                            >
                                Contribuyente Formal
                            </div>
                        </div>
                    </div>
                    <div class="clearfix invoice_main" style="position: relative;">
                        <div
                            t-if="o.company_id.account_fiscal_country_id.code == 'VE' and (not o.env.context.get('l10n_ve_invoice') or o.l10n_ve_invoice_original_printed)"
                            class="position-absolute w-100 text-center text-bold"
                            style="top: 25%; left: 0; right: 0; pointer-events: none;"
                        >
                            <span
                                class="text-uppercase opacity-25 text-danger"
                                style="font-size: 40px !important;"
                            >Copia fiel su original</span>
                        </div>
                        <div class="page mb-1">
                            <t
                                t-set="has_discount"
                                t-value="any(l.discount for l in o.invoice_line_ids)"
                            />
                            <table
                                class="table table-striped table-sm table-borderless mt-2 table-light"
                            >
                                <thead>
                                    <tr class="bg-secundary text-white border-bottom">
                                        <th
                                            class="col text-uppercase fw-bold text-nowrap text-center"
                                        >#</th>
                                        <th
                                            class="col text-uppercase fw-bold text-nowrap"
                                        >Codigo</th>
                                        <th
                                            class="col-5 text-uppercase fw-bold text-nowrap"
                                        >Descripcion</th>
                                        <th
                                            class="col text-uppercase fw-bold text-nowrap"
                                        >Cant.</th>
                                        <th
                                            class="col text-uppercase fw-bold text-nowrap"
                                        >Precio U.</th>
                                        <th
                                            class="col text-uppercase fw-bold text-nowrap"
                                            t-if="has_discount"
                                        >Desc.</th>
                                        <th
                                            class="col text-uppercase fw-bold text-nowrap"
                                        >Impuesto</th>
                                        <th
                                            class="col-1 text-uppercase fw-bold text-nowrap"
                                        >Subtotal</th>
                                        <th
                                            t-if="o.company_currency_id != o.currency_id"
                                            class="col-1 text-uppercase fw-bold text-nowrap"
                                        >Subtotal Moneda</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="l10n_ve_line_item" t-value="0" />
                                    <t t-foreach="o.invoice_line_ids" t-as="line">
                                        <tr
                                            t-att-class="'fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''"
                                        >
                                            <t t-if="line.display_type == 'product'">
                                                <t
                                                    t-set="l10n_ve_line_item"
                                                    t-value="l10n_ve_line_item + 1"
                                                />
                                                <td class="text-center text-nowrap">
                                                    <span t-out="l10n_ve_line_item" />
                                                </td>
                                                <td>
                                                    <span
                                                        t-field="line.product_id.default_code"
                                                    />
                                                </td>
                                                <td>
                                                    <span
                                                        t-out="line.l10n_ve_report_line_description()"
                                                    />
                                                    <t
                                                        t-if="line.tax_ids.amount == 0"
                                                    >(E)</t>
                                                </td>
                                                <td>
                                                    <span t-field="line.quantity" />
                                                </td>
                                                <td>
                                                    <span t-field="line.price_unit" />
                                                </td>
                                                <td t-if="has_discount"><span
                                                    t-field="line.discount"
                                                /> %</td>
                                                <td>
                                                    <span
                                                        t-field="line.tax_ids"
                                                        options="{'widget': 'many2many_tags'}"
                                                    />
                                                </td>
                                                <td>
                                                    <span
                                                        t-field="line.price_subtotal"
                                                    />
                                                </td>
                                                <td
                                                    t-if="o.company_currency_id != o.currency_id"
                                                >
                                                    <span
                                                        t-field="line.subtotal_company_currency"
                                                    />
                                                </td>
                                            </t>
                                            <t
                                                t-elif="line.display_type == 'line_section'"
                                            >
                                                <td
                                                    colspan="100"
                                                    class="text-muted bg-light ps-4"
                                                >
                                                    <span
                                                        t-if="line.name"
                                                        t-field="line.name"
                                                        t-options="{'widget': 'text'}"
                                                    >A section title</span>
                                                </td>
                                            </t>
                                            <t
                                                t-elif="line.display_type == 'line_note'"
                                            >
                                                <td
                                                    colspan="100"
                                                    class="text-muted bg-light ps-4"
                                                >
                                                    <span
                                                        t-if="line.name"
                                                        t-field="line.name"
                                                        t-options="{'widget': 'text'}"
                                                    > A note, whose content usually applies to the section or product above.</span>
                                                </td>
                                            </t>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <t
                                t-set="show_company_currency"
                                t-value="o.company_currency_id != o.currency_id"
                            />
                            <div class="overflow-hidden">
                                <div
                                    id="right-elements"
                                    t-attf-class="{{ 'col-6' if show_company_currency else 'col-4' }} mt-2 d-inline-block float-end"
                                >
                                    <div id="total" class="clearfix row ms-3">
                                        <div class="ms-auto">
                                            <t
                                                t-set="tax_totals"
                                                t-value="o.tax_totals or {}"
                                            />
                                            <t
                                                t-set="doc_currency"
                                                t-value="o.currency_id"
                                            />
                                            <t
                                                t-set="comp_currency"
                                                t-value="o.company_currency_id"
                                            />
                                            <style>
                                                #total .tax-totals-table tbody tr:first-child td {
                                                    border-top: none !important;
                                                }
                                            </style>
                                            <table
                                                class="table table-sm table-borderless tax-totals-table mb-0"
                                            >
                                                <thead>
                                                    <tr>
                                                        <t
                                                            t-if="not show_company_currency"
                                                        />
                                                        <th
                                                            class="text-end pe-2 py-1"
                                                        />
                                                        <th
                                                            class="text-end py-1"
                                                            style="min-width: 75px;"
                                                        >
                                                            Base <t
                                                            t-out="doc_currency.symbol"
                                                        />
                                                        </th>
                                                        <th
                                                            class="text-end py-1"
                                                            style="min-width: 75px;"
                                                        >
                                                            Impuesto <t
                                                            t-out="doc_currency.symbol"
                                                        />
                                                        </th>
                                                        <t t-if="show_company_currency">
                                                            <th
                                                                class="text-end py-1 ps-2"
                                                                style="min-width: 75px;"
                                                            >
                                                                Base <t
                                                                t-out="comp_currency.symbol"
                                                            />
                                                            </th>
                                                            <th
                                                                class="text-end py-1"
                                                                style="min-width: 75px;"
                                                            >
                                                                Impuesto <t
                                                                t-out="comp_currency.symbol"
                                                            />
                                                            </th>
                                                        </t>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t
                                                        t-foreach="tax_totals.get('subtotals', [])"
                                                        t-as="subtotal"
                                                    >
                                                        <tr class="border-bottom">
                                                            <td
                                                                class="text-end pe-2 py-1"
                                                            >
                                                                <span
                                                                    t-out="subtotal.get('name', 'Subtotal')"
                                                                />
                                                            </td>
                                                            <td class="text-end py-1">
                                                                <span
                                                                    t-out="subtotal.get('base_amount_currency', 0)"
                                                                    t-options='{"widget": "monetary", "display_currency": doc_currency}'
                                                                />
                                                            </td>
                                                            <td class="text-end py-1" />
                                                            <t
                                                                t-if="show_company_currency"
                                                            >
                                                                <td
                                                                    class="text-end py-1 ps-2"
                                                                >
                                                                    <span
                                                                        t-out="subtotal.get('base_amount', 0)"
                                                                        t-options='{"widget": "monetary", "display_currency": comp_currency}'
                                                                    />
                                                                </td>
                                                                <td
                                                                    class="text-end py-1"
                                                                />
                                                            </t>
                                                        </tr>
                                                        <t
                                                            t-foreach="subtotal.get('tax_groups', [])"
                                                            t-as="tax_group"
                                                        >
                                                            <tr>
                                                                <td
                                                                    class="text-end pe-2 py-1"
                                                                >
                                                                    <span
                                                                        t-out="tax_group.get('group_name', '')"
                                                                    />
                                                                </td>
                                                                <td
                                                                    class="text-end py-1"
                                                                >
                                                                    <span
                                                                        t-out="tax_group.get('display_base_amount_currency', tax_group.get('base_amount_currency', 0))"
                                                                        t-options='{"widget": "monetary", "display_currency": doc_currency}'
                                                                    />
                                                                </td>
                                                                <td
                                                                    class="text-end py-1"
                                                                >
                                                                    <span
                                                                        t-out="tax_group.get('tax_amount_currency', 0)"
                                                                        t-options='{"widget": "monetary", "display_currency": doc_currency}'
                                                                    />
                                                                </td>
                                                                <t
                                                                    t-if="show_company_currency"
                                                                >
                                                                    <td
                                                                        class="text-end py-1 ps-2"
                                                                    >
                                                                        <span
                                                                            t-out="tax_group.get('display_base_amount', tax_group.get('base_amount', 0))"
                                                                            t-options='{"widget": "monetary", "display_currency": comp_currency}'
                                                                        />
                                                                    </td>
                                                                    <td
                                                                        class="text-end py-1"
                                                                    >
                                                                        <span
                                                                            t-out="tax_group.get('tax_amount', 0)"
                                                                            t-options='{"widget": "monetary", "display_currency": comp_currency}'
                                                                        />
                                                                    </td>
                                                                </t>
                                                            </tr>
                                                        </t>
                                                    </t>
                                                    <tr
                                                        class="border-top border-2 fw-bold fs-5"
                                                    >
                                                        <td
                                                            class="text-end pe-2 py-1"
                                                        >Total</td>
                                                        <td class="text-end py-1" />
                                                        <td class="text-end py-1">
                                                            <span
                                                                t-out="tax_totals.get('total_amount_currency', 0)"
                                                                t-options='{"widget": "monetary", "display_currency": doc_currency}'
                                                            />
                                                        </td>
                                                        <t t-if="show_company_currency">
                                                            <td
                                                                class="text-end py-1 ps-2"
                                                            />
                                                            <td class="text-end py-1">
                                                                <span
                                                                    t-out="tax_totals.get('total_amount', 0)"
                                                                    t-options='{"widget": "monetary", "display_currency": comp_currency}'
                                                                />
                                                            </td>
                                                        </t>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                    <div class="mb-2">
                                        <p
                                            class="text-end lh-sm"
                                            t-if="o.company_id.display_invoice_amount_total_words"
                                        >
                                            Total amount in words: <br />
                                        <small class="text-muted lh-sm">
                                            <span
                                                t-field="o.amount_total_words"
                                            >Thirty one dollar and Five cents</span>
                                        </small>
                                    </p>
                                    </div>
                                </div>
                                <div id="payment_term" class="clearfix mt-3">
                                    <div class="justify-text">
                                        <span t-field="o.narration" />
                                        <span t-field="o.seniat_invoice_tag" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_invoice" inherit_id="account.report_invoice">
        <xpath expr="//t[@t-call='account.report_invoice_document']" position="after">
            <t t-call="l10n_ve_seniat.report_invoice_document" />
        </xpath>
    </template>
</odoo>
