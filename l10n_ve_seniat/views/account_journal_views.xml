<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_journal_form_inherit" model="ir.ui.view">
        <field name="name">account.journal.ve.form</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="SENIAT" invisible="type != 'sale'">
                    <group string="Configuración">
                        <field name="l10n_ve_emission_medium" />
                    </group>
                    <group
                        string="Tramos (talonario)"
                        invisible="type != 'sale' or l10n_ve_emission_medium in ('contingency', 'fiscal_machine', 'digital')"
                    >
                        <field
                            name="l10n_ve_invoice_section_id"
                            required="type == 'sale' and l10n_ve_emission_medium == 'free'"
                            options="{'no_create': False, 'no_quick_create': True}"
                        />
                        <field
                            name="l10n_ve_debit_note_section_id"
                            options="{'no_create': False, 'no_quick_create': True}"
                        />
                        <field
                            name="l10n_ve_credit_note_section_id"
                            required="type == 'sale' and l10n_ve_emission_medium == 'free'"
                            options="{'no_create': False, 'no_quick_create': True}"
                        />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
