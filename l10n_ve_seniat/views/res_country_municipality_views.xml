<odoo>
    <!-- TREE -->
    <record id="res_country_municipality_view_list" model="ir.ui.view">
        <field name="name">Municipality</field>
        <field name="model">res.country.municipality</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Municipalities">
                <field name="active" column_invisible="True" />
                <field name="code" />
                <field name="country_id" />
                <field
                    name="state_id"
                    widget="many2many_tags"
                    domain="[('country_id.code','ilike','ve')]"
                />
                <field name="name" />
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="res_country_municipality_view_form" model="ir.ui.view">
        <field name="name">Municipality</field>
        <field name="model">res.country.municipality</field>
        <field name="arch" type="xml">
            <form string="Municipality">
                <sheet string="Municipality">
                    <group>
                        <field name="active" invisible="1" />
                        <field name="code" />
                        <field name="country_id" />
                        <field
                            name="state_id"
                            widget="many2many_tags"
                            domain="[('country_id.code','ilike','ve')]"
                        />
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="res_country_municipality_action" model="ir.actions.act_window">
        <field name="name">Municipalities</field>
        <field name="res_model">res.country.municipality</field>
        <field name="type">ir.actions.act_window</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
