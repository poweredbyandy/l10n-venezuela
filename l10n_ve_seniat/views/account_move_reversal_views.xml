<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_move_reversal_view_form" model="ir.ui.view">
        <field name="name">account.move.reversal.form.l10n.ve</field>
        <field name="model">account.move.reversal</field>
        <field name="inherit_id" ref="account.view_account_move_reversal" />
        <field name="priority">110</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="before">
                <field name="l10n_ve_fiscal_country_code" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="attributes">
                <attribute
                    name="readonly"
                >l10n_ve_fiscal_country_code == 'VE'</attribute>
            </xpath>
            <xpath expr="//field[@name='date']" position="attributes">
                <attribute
                    name="readonly"
                >l10n_ve_fiscal_country_code == 'VE'</attribute>
            </xpath>
            <xpath expr="//field[@name='reason']" position="attributes">
                <attribute name="required">move_type != 'entry'</attribute>
            </xpath>
            <!-- Oculta modificación parcial no permitida en fiscalidad VE. -->
            <xpath expr="//button[@name='modify_moves']" position="replace" />
        </field>
    </record>
</odoo>
