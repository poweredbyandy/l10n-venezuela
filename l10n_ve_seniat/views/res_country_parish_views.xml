<odoo>
    <!-- TREE -->
    <record id="res_country_parish_view_list" model="ir.ui.view">
        <field name="name">res.country.parish.tree</field>
        <field name="model">res.country.parish</field>
        <field name="arch" type="xml">
            <list string="Parishes">
                <field name="name" />
                <field name="code" />
                <field name="municipality_id" />
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="res_country_parish_view_form" model="ir.ui.view">
        <field name="name">res.country.parish.form</field>
        <field name="model">res.country.parish</field>
        <field name="arch" type="xml">
            <form string="Parish">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="code" />
                        <field name="municipality_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="res_country_parish_action" model="ir.actions.act_window">
        <field name="name">Parish</field>
        <field name="res_model">res.country.parish</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
