<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_l10n_ve_seniat" model="ir.ui.view">
        <field name="name">res.config.settings.l10n.ve.seniat</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//block[@name='fiscal_localization_setting_container']"
                position="after"
            >
                <block
                    name="l10n_ve_seniat_block"
                    title="Venezuela - Tax Configuration"
                >
                    <div
                        id="l10n_ve_seniat_div_company_fiscal"
                        class="col-12 col-lg-6 o_setting_box"
                    >
                        <div class="o_setting_right_pane">
                            <separator string="Company Fiscal Info" />
                            <group>
                                <field name="taxpayer_type" string="Taxpayer Type" />
                                <field
                                    name="l10n_ve_on_behalf_of_third_party_enabled"
                                />
                                <field name="l10n_ve_validate_partner_vat_format" />
                                <field name="l10n_ve_lock_partner_fiscal_data" />
                                <field name="l10n_ve_enforce_sale_price_ge_cost" />
                            </group>
                        </div>
                    </div>
                    <div
                        id="l10n_ve_seniat_div_tax_rates_sales"
                        class="col-12 col-lg-6 o_setting_box"
                    >
                        <div class="o_setting_right_pane">
                            <separator string="Sales Tax Rates" />
                            <group>
                                <field
                                    name="exent_aliquot_sale"
                                    string="Exempt Aliquot"
                                />
                                <field
                                    name="general_aliquot_sale"
                                    string="General Aliquot"
                                />
                                <field
                                    name="reduced_aliquot_sale"
                                    string="Reduced Aliquot"
                                />
                                <field
                                    name="extend_aliquot_sale"
                                    string="Extended Aliquot"
                                />
                            </group>
                        </div>
                    </div>
                    <div
                        id="l10n_ve_seniat_div_tax_rates_purchases"
                        class="col-12 col-lg-6 o_setting_box"
                    >
                        <div class="o_setting_right_pane">
                            <separator string="Purchase Tax Rates" />
                            <group>
                                <field
                                    name="exent_aliquot_purchase"
                                    string="Exempt Aliquot"
                                />
                                <field
                                    name="general_aliquot_purchase"
                                    string="General Aliquot"
                                />
                                <field
                                    name="reduced_aliquot_purchase"
                                    string="Reduced Aliquot"
                                />
                                <field
                                    name="extend_aliquot_purchase"
                                    string="Extended Aliquot"
                                />
                            </group>
                        </div>
                    </div>
                </block>
                <block
                    id="l10n_ve_extended_localization_settings"
                    name="l10n_ve_extended_localization_settings"
                    title="Venezuela - Retenciones e IGTF"
                />
            </xpath>
        </field>
    </record>
</odoo>
