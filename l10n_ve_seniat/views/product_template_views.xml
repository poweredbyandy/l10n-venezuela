<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_tree_l10n_ve_sale_tax" model="ir.ui.view">
        <field name="name">product.template.list.l10n.ve.sale.tax.readonly</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_view_tree" />
        <field name="arch" type="xml">
            <field name="taxes_id" position="before">
                <field
                    name="l10n_ve_sale_taxes_readonly"
                    column_invisible="1"
                />
            </field>
            <field name="taxes_id" position="attributes">
                <attribute name="readonly">l10n_ve_sale_taxes_readonly</attribute>
            </field>
        </field>
    </record>
    <record id="product_template_form_l10n_ve_sale_tax" model="ir.ui.view">
        <field name="name">product.template.form.l10n.ve.sale.tax.readonly</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//div[@name='taxes_div']//field[@name='taxes_id']"
                position="attributes"
            >
                <attribute name="readonly">l10n_ve_sale_taxes_readonly</attribute>
            </xpath>
        </field>
    </record>
    <record id="product_product_form_l10n_ve_sale_tax" model="ir.ui.view">
        <field name="name">product.product.form.normalized.l10n.ve.sale.tax.readonly</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="account.product_product_view_form_normalized_account" />
        <field name="arch" type="xml">
            <field name="taxes_id" position="attributes">
                <attribute name="readonly">l10n_ve_sale_taxes_readonly</attribute>
            </field>
        </field>
    </record>
</odoo>
