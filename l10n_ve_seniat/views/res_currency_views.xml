<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_currency_form_l10n_ve_chatter" model="ir.ui.view">
        <field name="name">res.currency.form.l10n.ve.chatter</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="after">
                <chatter />
            </xpath>
        </field>
    </record>

    <record id="view_currency_rate_form_l10n_ve" model="ir.ui.view">
        <field name="name">res.currency.rate.form.l10n.ve</field>
        <field name="model">res.currency.rate</field>
        <field name="inherit_id" ref="base.view_currency_rate_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="l10n_ve_rate_count_readonly" invisible="1" />
                <field
                    name="l10n_ve_rate_edit_count"
                    readonly="l10n_ve_rate_count_readonly"
                />
            </xpath>
            <xpath expr="//sheet" position="after">
                <chatter />
            </xpath>
        </field>
    </record>

    <record id="view_currency_form_l10n_ve_rate_list" model="ir.ui.view">
        <field name="name">res.currency.form.l10n.ve.rate.list</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='rate_ids']/list/field[1]" position="before">
                <field name="l10n_ve_is_today" column_invisible="1" />
                <field name="l10n_ve_rate_count_readonly" column_invisible="1" />
            </xpath>
            <xpath
                expr="//field[@name='rate_ids']/list/field[@name='name']"
                position="after"
            >
                <field
                    name="l10n_ve_rate_edit_count"
                    string="Ediciones"
                    optional="show"
                    readonly="l10n_ve_rate_count_readonly"
                />
            </xpath>
            <xpath
                expr="//field[@name='rate_ids']/list/field[@name='name']"
                position="attributes"
            >
                <attribute name="readonly">not l10n_ve_is_today</attribute>
            </xpath>
            <xpath
                expr="//field[@name='rate_ids']/list/field[@name='company_rate']"
                position="attributes"
            >
                <attribute name="readonly">not l10n_ve_is_today</attribute>
            </xpath>
            <xpath
                expr="//field[@name='rate_ids']/list/field[@name='inverse_company_rate']"
                position="attributes"
            >
                <attribute name="readonly">not l10n_ve_is_today</attribute>
            </xpath>
            <xpath
                expr="//field[@name='rate_ids']/list/field[@name='rate']"
                position="attributes"
            >
                <attribute name="readonly">not l10n_ve_is_today</attribute>
            </xpath>
        </field>
    </record>
</odoo>
