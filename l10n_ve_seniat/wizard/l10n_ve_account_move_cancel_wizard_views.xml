<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_ve_account_move_cancel_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_ve.account.move.cancel.wizard.form</field>
        <field name="model">l10n_ve.account.move.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Anular documento">
                <!-- Art. 18 PA SNAT/2024/000102: motivo obligatorio de anulación. -->
                <group>
                    <field name="move_id" invisible="1" />
                    <field
                        name="reason_id"
                        options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                    />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        string="Confirmar anulación"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button string="Cerrar" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
