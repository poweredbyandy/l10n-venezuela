<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mail_template_unfactured_dispatch_guides" model="mail.template">
        <field name="name">Guías de despacho no facturadas</field>
        <field name="model_id" ref="base.model_res_company" />
        <field
            name="email_from"
        >{{ object.l10n_ve_implementer_email_from() or object.email_formatted or user.email_formatted }}</field>
        <field
            name="subject"
        >[SENIAT] {{ object.name }} — Guías de despacho sin facturar ({{ object.l10n_ve_unfactured_dispatch_email_count() }})</field>
        <field name="body_html" type="html">
            <t
                t-set="rows"
                t-value="object.l10n_ve_unfactured_dispatch_guides_for_email()"
            />
            <t t-set="guide_count" t-value="object.l10n_ve_unfactured_dispatch_email_count()" />
            <div
                style="margin: 0; padding: 0; background-color: #eef2f7; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1f2937;"
            >
                <div style="max-width: 720px; margin: 0 auto; padding: 24px 16px;">
                    <div
                        style="background-color: #0b2e59; border-radius: 8px 8px 0 0; padding: 28px 32px; color: #ffffff;"
                    >
                        <div
                            style="font-size: 11px; letter-spacing: 1.4px; text-transform: uppercase; opacity: 0.82; margin-bottom: 8px;"
                        >
                            República Bolivariana de Venezuela · Servicio Nacional Integrado de Administración Aduanera y Tributaria
                        </div>
                        <div
                            style="font-size: 22px; font-weight: 700; line-height: 1.3; margin: 0 0 6px 0;"
                        >
                            Notificación de control documental
                        </div>
                        <div style="font-size: 14px; opacity: 0.92; margin: 0;">
                            Guías de despacho pendientes de facturación
                        </div>
                        <t t-if="object.l10n_ve_implementer_is_configured()">
                            <div
                                style="font-size: 12px; margin-top: 14px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.2); line-height: 1.5;"
                            >
                                Mensaje enviado por
                                <strong t-out="object.l10n_ve_implementer_name()" />
                                <t t-if="object.l10n_ve_implementer_vat()">
                                    · RIF <t t-out="object.l10n_ve_implementer_vat()" />
                                </t>
                                <t t-if="object.l10n_ve_implementer_email()">
                                    · <t t-out="object.l10n_ve_implementer_email()" />
                                </t>
                            </div>
                        </t>
                    </div>

                    <div
                        style="background-color: #ffffff; border: 1px solid #d7dee8; border-top: none; padding: 28px 32px;"
                    >
                        <table
                            style="width: 100%; border-collapse: collapse; margin-bottom: 24px; font-size: 13px;"
                        >
                            <tr>
                                <td
                                    style="padding: 0 0 8px 0; width: 34%; color: #64748b; font-weight: 600;"
                                >Contribuyente</td>
                                <td style="padding: 0 0 8px 0; font-weight: 600;">
                                    <t t-out="object.name or ''" />
                                </td>
                            </tr>
                            <tr t-if="object.vat">
                                <td style="padding: 0 0 8px 0; color: #64748b; font-weight: 600;">RIF</td>
                                <td style="padding: 0 0 8px 0;">
                                    <t t-out="object.vat" />
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 0 0 8px 0; color: #64748b; font-weight: 600;">Fecha del reporte</td>
                                <td style="padding: 0 0 8px 0;">
                                    <t t-out="object.l10n_ve_unfactured_dispatch_email_issue_date()" />
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 0; color: #64748b; font-weight: 600;">Generado el</td>
                                <td style="padding: 0;">
                                    <t t-out="object.l10n_ve_unfactured_dispatch_email_report_date()" />
                                </td>
                            </tr>
                        </table>

                        <div
                            style="background-color: #f8fafc; border: 1px solid #dbe4ef; border-left: 4px solid #b91c1c; border-radius: 6px; padding: 18px 20px; margin-bottom: 24px;"
                        >
                            <div
                                style="font-size: 12px; letter-spacing: 0.8px; text-transform: uppercase; color: #b91c1c; font-weight: 700; margin-bottom: 6px;"
                            >
                                Resumen ejecutivo
                            </div>
                            <div style="font-size: 15px; line-height: 1.55; margin: 0;">
                                <t t-if="guide_count">
                                    Hay
                                    <strong t-out="guide_count" />
                                    guía(s) de despacho confirmada(s) sin facturar.
                                </t>
                                <t t-else="">
                                    No hay guías de despacho confirmadas pendientes de facturación.
                                </t>
                            </div>
                        </div>

                        <p style="font-size: 14px; line-height: 1.65; margin: 0 0 20px 0; color: #334155;">
                            Listado de guías de despacho pendientes de facturación:
                        </p>

                        <t t-if="rows">
                            <div
                                style="font-size: 13px; font-weight: 700; color: #0b2e59; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.6px;"
                            >
                                Detalle de guías pendientes
                            </div>
                            <table
                                style="width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 24px;"
                            >
                                <thead>
                                    <tr style="background-color: #0b2e59; color: #ffffff;">
                                        <th
                                            style="border: 1px solid #0b2e59; padding: 10px 8px; text-align: left;"
                                        >N° documento</th>
                                        <th
                                            style="border: 1px solid #0b2e59; padding: 10px 8px; text-align: left;"
                                        >N° control</th>
                                        <th
                                            style="border: 1px solid #0b2e59; padding: 10px 8px; text-align: left;"
                                        >Cliente</th>
                                        <th
                                            style="border: 1px solid #0b2e59; padding: 10px 8px; text-align: left;"
                                        >Documento origen</th>
                                        <th
                                            style="border: 1px solid #0b2e59; padding: 10px 8px; text-align: left;"
                                        >Fecha de entrega</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr
                                        t-foreach="rows"
                                        t-as="row"
                                        t-att-style="'background-color: %s;' % ('#ffffff' if row_index % 2 == 0 else '#f8fafc')"
                                    >
                                        <td
                                            style="border: 1px solid #dbe4ef; padding: 9px 8px; font-weight: 600;"
                                            t-out="row['name']"
                                        />
                                        <td
                                            style="border: 1px solid #dbe4ef; padding: 9px 8px;"
                                            t-out="row['control_number']"
                                        />
                                        <td
                                            style="border: 1px solid #dbe4ef; padding: 9px 8px;"
                                            t-out="row['partner']"
                                        />
                                        <td
                                            style="border: 1px solid #dbe4ef; padding: 9px 8px;"
                                            t-out="row['origin']"
                                        />
                                        <td
                                            style="border: 1px solid #dbe4ef; padding: 9px 8px;"
                                            t-out="row['date_done']"
                                        />
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <p style="font-size: 12px; line-height: 1.6; color: #64748b; margin: 0;">
                            <t t-if="object.l10n_ve_implementer_is_configured()">
                                Correo generado por
                                <strong t-out="object.l10n_ve_implementer_name()" />
                                a través del módulo SENIAT en Odoo.
                            </t>
                            <t t-else="">
                                Correo generado automáticamente por el módulo SENIAT en Odoo.
                            </t>
                        </p>
                    </div>

                    <div
                        style="background-color: #ffffff; border: 1px solid #d7dee8; border-top: none; border-radius: 0 0 8px 8px; padding: 16px 32px 20px 32px; text-align: center;"
                    >
                        <div style="font-size: 11px; color: #94a3b8; line-height: 1.5;">
                            <t t-if="object.l10n_ve_implementer_is_configured()">
                                <strong t-out="object.l10n_ve_implementer_name()" />
                                <t t-if="object.l10n_ve_implementer_vat()">
                                    · RIF <t t-out="object.l10n_ve_implementer_vat()" />
                                </t>
                                · Reporte del contribuyente
                            </t>
                            Documento informativo de control interno ·
                            <strong t-out="object.name or ''" />
                            <t t-if="object.vat"> · RIF <t t-out="object.vat" /></t>
                        </div>
                    </div>
                </div>
            </div>
        </field>
        <field name="auto_delete" eval="True" />
    </record>
</odoo>
