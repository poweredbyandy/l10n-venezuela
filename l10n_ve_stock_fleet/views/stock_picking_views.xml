<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form.l10n.ve.fleet</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <field name="l10n_ve_carrier_name" position="before">
                <field name="l10n_ve_own_fleet" invisible="1" />
            </field>
            <field name="l10n_ve_carrier_name" position="attributes">
                <attribute name="readonly">l10n_ve_own_fleet</attribute>
            </field>
            <field name="l10n_ve_carrier_vat" position="attributes">
                <attribute name="readonly">l10n_ve_own_fleet</attribute>
            </field>
            <field name="l10n_ve_vehicle_plate" position="attributes">
                <attribute name="readonly">l10n_ve_own_fleet</attribute>
            </field>
            <field name="l10n_ve_vehicle_plate" position="after">
                <field
                    name="l10n_ve_transport_partner_id"
                    invisible="not l10n_ve_own_fleet or not l10n_ve_dispatch_guide_enabled or not l10n_ve_is_ve_country or picking_type_code != 'outgoing'"
                />
                <field
                    name="l10n_ve_fleet_vehicle_id"
                    invisible="not l10n_ve_own_fleet or not l10n_ve_dispatch_guide_enabled or not l10n_ve_is_ve_country or picking_type_code != 'outgoing'"
                />
            </field>
        </field>
    </record>
</odoo>
