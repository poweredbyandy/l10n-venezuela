<odoo>
    <record id="view_l10n_ve_igtf_unreconcile_payment_wizard" model="ir.ui.view">
        <field name="name">l10n_ve_igtf.unreconcile.payment.wizard.form</field>
        <field name="model">l10n_ve_igtf.unreconcile.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="IGTF Payment">
                <group>
                    <field name="move_id" readonly="1" />
                    <field name="payment_id" readonly="1" />
                    <field name="partial_id" readonly="1" />
                </group>
                <group>
                    <div
                        class="o_form_label"
                    >This payment includes IGTF. What do you want to do?</div>
                    <field name="action" widget="radio" />
                </group>
                <footer>
                    <button
                        string="Confirm"
                        name="action_confirm"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
