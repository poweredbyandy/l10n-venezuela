<odoo>
    <record id="account_payment_igtf_receipt_action" model="ir.actions.report">
        <field name="name">IGTF Receipt</field>
        <field name="model">account.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ve_igtf.report_igtf_receipt</field>
        <field name="report_file">l10n_ve_igtf.report_igtf_receipt</field>
        <field name="print_report_name">'Recibo IGTF - %s' % (object.name)</field>
        <field
            name="domain"
        >[("l10n_ve_apply_igtf", "=", True), ("state", "!=", "draft")]</field>
        <field name="binding_model_id" ref="account.model_account_payment" />
        <field name="binding_type">report</field>
    </record>
</odoo>
