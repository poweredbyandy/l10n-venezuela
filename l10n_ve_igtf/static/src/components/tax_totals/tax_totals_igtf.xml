<?xml version="1.0" encoding="utf-8" ?>
<templates>
    <t t-name="l10n_ve_igtf.TaxTotalsField" owl="1">
        <t t-if="taxTotals">
            <div class="o_tax_totals_company_currency">
                <div
                    t-if="taxTotals.display_in_company_currency"
                    class="o_tax_totals_responsive d-md-none"
                >
                    <t t-if="taxTotals.subtotals">
                        <t
                            t-foreach="taxTotals.subtotals"
                            t-as="subtotal"
                            t-key="subtotal_index"
                        >
                            <div class="o_tax_totals_responsive_line">
                                <span class="o_form_label" t-out="responsiveBaseLabel(false)" />
                                <span
                                    class="o_list_monetary"
                                    t-out="formatAmount(subtotal.base_amount_currency || 0, false)"
                                />
                            </div>
                            <div class="o_tax_totals_responsive_line">
                                <span class="o_form_label" t-out="responsiveBaseLabel(true)" />
                                <span
                                    class="o_list_monetary"
                                    t-out="formatAmount(subtotal.base_amount || 0, true)"
                                />
                            </div>
                            <t
                                t-foreach="subtotal.tax_groups"
                                t-as="taxGroup"
                                t-key="taxGroup_index"
                            >
                                <div class="o_tax_totals_responsive_line">
                                    <span
                                        class="o_form_label"
                                        t-out="responsiveLabel(taxGroup.group_name, false)"
                                    />
                                    <span
                                        class="o_list_monetary"
                                        t-out="taxGroupText(taxGroup, false)"
                                    />
                                </div>
                                <div class="o_tax_totals_responsive_line">
                                    <span
                                        class="o_form_label"
                                        t-out="responsiveLabel(taxGroup.group_name, true)"
                                    />
                                    <span
                                        class="o_list_monetary"
                                        t-out="taxGroupText(taxGroup, true)"
                                    />
                                </div>
                            </t>
                        </t>
                    </t>
                    <t t-if="hasIgtfTotal">
                        <div class="o_tax_totals_responsive_line o_tax_totals_responsive_total">
                            <span class="o_form_label" t-out="responsiveTotalLabel(false)" />
                            <span
                                class="o_list_monetary"
                                t-out="formatAmount(taxTotals.l10n_ve_igtf_total_without_igtf_currency, false)"
                            />
                        </div>
                        <div class="o_tax_totals_responsive_line">
                            <span class="o_form_label" t-out="responsiveTotalLabel(true)" />
                            <span
                                class="o_list_monetary"
                                t-out="formatAmount(taxTotals.l10n_ve_igtf_total_without_igtf, true)"
                            />
                        </div>
                        <div class="o_tax_totals_responsive_line">
                            <span class="o_form_label" t-out="responsiveIgtfTotalLabel(false)" />
                            <span
                                class="o_list_monetary"
                                t-out="formatAmount(taxTotals.total_amount_currency || 0, false)"
                            />
                        </div>
                        <div class="o_tax_totals_responsive_line">
                            <span class="o_form_label" t-out="responsiveIgtfTotalLabel(true)" />
                            <span
                                class="o_list_monetary"
                                t-out="formatAmount(taxTotals.total_amount || 0, true)"
                            />
                        </div>
                    </t>
                    <t t-else="">
                        <div class="o_tax_totals_responsive_line o_tax_totals_responsive_total">
                            <span class="o_form_label" t-out="responsiveTotalLabel(false)" />
                            <span
                                class="o_list_monetary"
                                t-out="formatAmount(taxTotals.total_amount_currency || 0, false)"
                            />
                        </div>
                        <div class="o_tax_totals_responsive_line">
                            <span class="o_form_label" t-out="responsiveTotalLabel(true)" />
                            <span
                                class="o_list_monetary"
                                t-out="formatAmount(taxTotals.total_amount || 0, true)"
                            />
                        </div>
                    </t>
                </div>
                <table
                    t-att-class="{'float-end': true, 'd-none': taxTotals.display_in_company_currency, 'd-md-table': taxTotals.display_in_company_currency}"
                >
                    <tbody>
                        <t t-if="taxTotals.subtotals">
                            <t
                                t-foreach="taxTotals.subtotals"
                                t-as="subtotal"
                                t-key="subtotal_index"
                            >
                                <tr>
                                    <td class="o_td_label">
                                        <label
                                            class="o_form_label o_tax_total_label"
                                            t-out="subtotal.name"
                                        />
                                    </td>
                                    <td class="o_list_monetary">
                                        <span
                                            class="o_list_monetary"
                                            t-att-name="subtotal.name"
                                            style="white-space: nowrap; font-weight: bold;"
                                            t-out="formatAmount(subtotal.base_amount_currency || 0, false)"
                                        />
                                    </td>
                                    <td
                                        t-if="taxTotals.display_in_company_currency"
                                        class="o_list_monetary ps-5 o_tax_totals_company_col"
                                    >
                                        <span
                                            class="o_list_monetary o_tax_totals_company_amount"
                                            t-att-name="subtotal.name + '_company'"
                                            style="white-space: nowrap; font-weight: bold;"
                                            t-out="formatAmount(subtotal.base_amount || 0, true)"
                                        />
                                    </td>
                                </tr>
                                <t
                                    t-foreach="subtotal.tax_groups"
                                    t-as="taxGroup"
                                    t-key="taxGroup_index"
                                >
                                    <tr>
                                        <td class="o_td_label">
                                            <label
                                                class="o_form_label o_tax_total_label"
                                                t-out="taxGroup.group_name"
                                            />
                                        </td>
                                        <td class="o_list_monetary">
                                            <span
                                                class="o_tax_group_amount_value o_list_monetary"
                                                style="white-space: nowrap;"
                                                t-out="'(' + formatAmount(taxGroup.display_base_amount_currency ?? taxGroup.base_amount_currency ?? 0, false) + ') ' + formatAmount(taxGroup.tax_amount_currency || 0, false)"
                                            />
                                        </td>
                                        <td
                                            t-if="taxTotals.display_in_company_currency"
                                            class="o_list_monetary ps-5 o_tax_totals_company_col"
                                        >
                                            <span
                                                class="o_tax_group_amount_value o_list_monetary o_tax_totals_company_amount"
                                                style="white-space: nowrap;"
                                                t-out="'(' + formatAmount(taxGroup.display_base_amount ?? taxGroup.base_amount ?? 0, true) + ') ' + formatAmount(taxGroup.tax_amount || 0, true)"
                                            />
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </t>
                        <t t-if="'cash_rounding_base_amount_currency' in taxTotals">
                            <tr>
                                <td class="o_td_label">
                                    <label
                                        class="o_form_label o_tax_total_label"
                                    >Rounding</label>
                                </td>
                                <td class="o_list_monetary">
                                    <span
                                        class="o_list_monetary"
                                        style="white-space: nowrap;"
                                        t-out="formatAmount(taxTotals.cash_rounding_base_amount_currency, false)"
                                    />
                                </td>
                                <td
                                    t-if="taxTotals.display_in_company_currency"
                                    class="o_list_monetary ps-5 o_tax_totals_company_col"
                                >
                                    <span
                                        class="o_list_monetary o_tax_totals_company_amount"
                                        style="white-space: nowrap;"
                                        t-out="formatAmount(taxTotals.cash_rounding_base_amount || 0, true)"
                                    />
                                </td>
                            </tr>
                        </t>
                        <t t-if="hasIgtfTotal">
                            <tr>
                                <td class="o_td_label">
                                    <label
                                        class="o_form_label o_tax_total_label"
                                    >Total</label>
                                </td>
                                <td class="o_list_monetary">
                                    <span
                                        class="o_list_monetary"
                                        name="l10n_ve_igtf_total_without_igtf"
                                        style="white-space: nowrap; font-weight: 600;"
                                        t-out="formatAmount(taxTotals.l10n_ve_igtf_total_without_igtf_currency, false)"
                                    />
                                </td>
                                <td
                                    t-if="taxTotals.display_in_company_currency"
                                    class="o_list_monetary ps-5 o_tax_totals_company_col"
                                >
                                    <span
                                        class="o_list_monetary o_tax_totals_company_amount"
                                        name="l10n_ve_igtf_total_without_igtf_company"
                                        style="white-space: nowrap; font-weight: 600;"
                                        t-out="formatAmount(taxTotals.l10n_ve_igtf_total_without_igtf, true)"
                                    />
                                </td>
                            </tr>
                            <tr>
                                <td class="o_td_label">
                                    <label
                                        class="o_form_label o_tax_total_label"
                                    >Total con IGTF</label>
                                </td>
                                <td class="o_list_monetary">
                                    <span
                                        class="o_list_monetary"
                                        name="amount_total"
                                        t-att-class="{'oe_subtotal_footer_separator': taxTotals.has_tax_groups}"
                                        style="font-size: 1.3em; font-weight: bold; white-space: nowrap;"
                                        t-out="formatAmount(taxTotals.total_amount_currency || 0, false)"
                                    />
                                </td>
                                <td
                                    t-if="taxTotals.display_in_company_currency"
                                    class="o_list_monetary ps-5 o_tax_totals_company_col"
                                >
                                    <span
                                        class="o_list_monetary o_tax_totals_company_amount"
                                        name="amount_total_company"
                                        t-att-class="{'oe_subtotal_footer_separator': taxTotals.has_tax_groups}"
                                        style="font-size: 1.3em; font-weight: bold; white-space: nowrap;"
                                        t-out="formatAmount(taxTotals.total_amount || 0, true)"
                                    />
                                </td>
                            </tr>
                        </t>
                        <t t-else="">
                            <tr>
                                <td class="o_td_label">
                                    <label
                                        class="o_form_label o_tax_total_label"
                                    >Total</label>
                                </td>
                                <td class="o_list_monetary">
                                    <span
                                        class="o_list_monetary"
                                        name="amount_total"
                                        t-att-class="{'oe_subtotal_footer_separator': taxTotals.has_tax_groups}"
                                        style="font-size: 1.3em; font-weight: bold; white-space: nowrap;"
                                        t-out="formatAmount(taxTotals.total_amount_currency || 0, false)"
                                    />
                                </td>
                                <td
                                    t-if="taxTotals.display_in_company_currency"
                                    class="o_list_monetary ps-5 o_tax_totals_company_col"
                                >
                                    <span
                                        class="o_list_monetary o_tax_totals_company_amount"
                                        name="amount_total_company"
                                        t-att-class="{'oe_subtotal_footer_separator': taxTotals.has_tax_groups}"
                                        style="font-size: 1.3em; font-weight: bold; white-space: nowrap;"
                                        t-out="formatAmount(taxTotals.total_amount || 0, true)"
                                    />
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </t>
</templates>
