<odoo>
    <record id="view_account_payment_form_l10n_ve_igtf" model="ir.ui.view">
        <field name="name">account.payment.form.l10n_ve_igtf</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='amount_div']" position="after">
                <field name="country_code" invisible="1" />
                <field name="l10n_ve_show_apply_igtf" invisible="1" />
                <field
                    name="l10n_ve_apply_igtf"
                    invisible="country_code != 'VE' or not l10n_ve_show_apply_igtf"
                    readonly="1"
                />
                <field
                    name="l10n_ve_igtf_included"
                    invisible="country_code != 'VE' or not l10n_ve_apply_igtf or not l10n_ve_show_apply_igtf"
                    readonly="1"
                />
                <field
                    name="l10n_ve_igtf_amount_currency"
                    widget="monetary"
                    readonly="1"
                    invisible="country_code != 'VE' or not l10n_ve_apply_igtf or not l10n_ve_show_apply_igtf"
                />
                <field
                    name="l10n_ve_igtf_amount_company_currency"
                    widget="monetary"
                    readonly="1"
                    invisible="country_code != 'VE' or not l10n_ve_apply_igtf or not l10n_ve_show_apply_igtf"
                />
            </xpath>
        </field>
    </record>
</odoo>
