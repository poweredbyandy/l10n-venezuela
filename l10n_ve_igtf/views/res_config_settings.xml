<odoo>
    <record id="res_config_settings_view_form_inherit_l10n_ve_igtf" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.l10n_ve_igtf</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_ve_seniat.res_config_settings_l10n_ve_seniat" />
        <field name="priority" eval="25" />
        <field name="arch" type="xml">
            <xpath
                expr="//block[@id='l10n_ve_extended_localization_settings']"
                position="inside"
            >
                <field name="l10n_ve_igtf_settings_eligible" invisible="1" />
                <setting
                    string="Venezuela - IGTF"
                    help="Solo para compañías con país fiscal Venezuela y tipo de contribuyente Especial. Active la casilla para aplicar IGTF en facturas, pagos y totales."
                    invisible="not l10n_ve_igtf_settings_eligible"
                >
                    <div class="content-group">
                        <field
                            name="l10n_ve_igtf_enabled"
                            widget="boolean_toggle"
                            string="Aplicar IGTF"
                        />
                        <div
                            class="mt16"
                            invisible="not l10n_ve_igtf_enabled"
                        >
                            <div class="row mt8">
                                <label
                                    for="l10n_ve_igtf_account_id"
                                    class="col-lg-5 o_light_label"
                                    string="IGTF Account"
                                />
                                <field
                                    name="l10n_ve_igtf_account_id"
                                    domain="[('account_type', '=', 'liability_payable')]"
                                />
                            </div>
                            <div class="row mt8">
                                <label
                                    for="l10n_ve_igtf_currency_ids"
                                    class="col-lg-5 o_light_label"
                                    string="IGTF Currencies"
                                />
                                <field
                                    name="l10n_ve_igtf_currency_ids"
                                    widget="many2many_tags"
                                />
                            </div>
                            <div class="row mt8">
                                <label
                                    for="l10n_ve_igtf_allow_invoice_accrual"
                                    class="col-lg-5 o_light_label"
                                    string="IGTF en facturas"
                                />
                                <field
                                    name="l10n_ve_igtf_allow_invoice_accrual"
                                    widget="boolean_toggle"
                                />
                                <div class="text-muted col-lg-12 mt8">
                                    Si está desactivado, el IGTF solo se aplica al registrar cobros o pagos;
                                    no se generan líneas de IGTF al confirmar la factura en divisa.
                                </div>
                            </div>
                            <div class="row mt8">
                                <label
                                    for="l10n_ve_igtf_percent"
                                    class="col-lg-5 o_light_label"
                                    string="IGTF (%)"
                                />
                                <field name="l10n_ve_igtf_percent" />
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
