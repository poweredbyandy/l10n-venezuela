<odoo>
    <record id="res_config_settings_view_form_inherit_l10n_ve_igtf" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.l10n_ve_igtf</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block id="default_accounts" position="inside">
                <setting string="Venezuela IGTF" invisible="not l10n_ve_is_ve_country">
                    <div class="content-group">
                        <field name="l10n_ve_is_ve_country" invisible="1" />
                        <div class="row mt8">
                            <label
                                for="l10n_ve_igtf_account_id"
                                class="col-lg-5 o_light_label"
                                string="IGTF Account"
                            />
                            <field
                                name="l10n_ve_igtf_account_id"
                                domain="[('account_type', '=', 'liability_payable')]"
                            />
                        </div>
                        <div class="row mt8">
                            <label
                                for="l10n_ve_igtf_currency_ids"
                                class="col-lg-5 o_light_label"
                                string="IGTF Currencies"
                            />
                            <field
                                name="l10n_ve_igtf_currency_ids"
                                widget="many2many_tags"
                            />
                        </div>
                        <div class="row mt8">
                            <label
                                for="l10n_ve_igtf_percent"
                                class="col-lg-5 o_light_label"
                                string="IGTF (%)"
                            />
                            <field name="l10n_ve_igtf_percent" />
                        </div>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>
