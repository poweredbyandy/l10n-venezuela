<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Extend Form view -->
    <record id="view_auditlog_http_session_form_ip" model="ir.ui.view">
        <field name="name">auditlog.http.session.form.ip</field>
        <field name="model">auditlog.http.session</field>
        <field name="inherit_id" ref="auditlog.view_auditlog_http_session_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="ip_address" />
            </xpath>
        </field>
    </record>
    <!-- Extend Tree view -->
    <record id="view_auditlog_http_session_tree_ip" model="ir.ui.view">
        <field name="name">auditlog.http.session.list.ip</field>
        <field name="model">auditlog.http.session</field>
        <field name="inherit_id" ref="auditlog.view_auditlog_http_session_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="ip_address" />
            </xpath>
        </field>
    </record>
    <!-- Extend Search view -->
    <record id="view_auditlog_http_session_search_ip" model="ir.ui.view">
        <field name="name">auditlog.http.session.search.ip</field>
        <field name="model">auditlog.http.session</field>
        <field name="inherit_id" ref="auditlog.view_auditlog_http_session_search" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="ip_address" />
            </xpath>
            <xpath expr="//filter[@name='group_by_create_date']" position="after">
                <filter
                    name="group_by_ip_address"
                    string="IP Address"
                    domain="[]"
                    context="{'group_by':'ip_address'}"
                />
            </xpath>
        </field>
    </record>
</odoo>
